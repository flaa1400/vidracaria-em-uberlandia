---
import Layout from '../../../layouts/Layout.astro';
import { NEIGHBORHOODS, type NeighborhoodData } from '../../../data/neighborhoodsData';
import { SERVICES_LIST, type ServiceData } from '../../../data/servicesData';
import { SITE_CONFIG } from '../../../data/config';
import ServiceIcon from '../../../components/ServiceIcon.astro';
import { generateNeighborhoodServiceContent } from '../../../utils/seoContentGenerator';

export const prerender = true;

export async function getStaticPaths() {
  const paths = [];
  for (const neighborhood of NEIGHBORHOODS) {
    for (const service of SERVICES_LIST) {
      paths.push({
        params: { bairro: neighborhood.slug, servico: service.slug },
        props: { neighborhood, service },
      });
    }
  }
  return paths;
}

interface Props {
  neighborhood: NeighborhoodData;
  service: ServiceData;
}

const { neighborhood, service } = Astro.props;
const content = generateNeighborhoodServiceContent(neighborhood, service);

// Filter other services for internal linking in the same neighborhood
const otherServices = SERVICES_LIST.filter((s) => s.slug !== service.slug);

const whatsappServiceUrl = `https://wa.me/${SITE_CONFIG.whatsappRaw}?text=${encodeURIComponent(
  `Olá, vim do site Vidraçaria Axis Glass e gostaria de um orçamento de ${service.title} para meu imóvel no bairro ${neighborhood.name} em Uberlândia.`
)}`;

const schemaService = {
  '@context': 'https://schema.org',
  '@type': 'Service',
  name: `${service.title} no ${neighborhood.name} em Uberlândia`,
  serviceType: service.title,
  description: content.metaDescription,
  provider: {
    '@type': 'LocalBusiness',
    name: 'Vidraçaria Axis Glass',
    telephone: SITE_CONFIG.whatsapp,
    address: {
      '@type': 'PostalAddress',
      streetAddress: SITE_CONFIG.address.streetAddress,
      addressLocality: 'Uberlândia',
      addressRegion: 'MG',
      addressCountry: 'BR',
    },
  },
  areaServed: {
    '@type': 'Place',
    name: `${neighborhood.name}, Uberlândia - MG`,
  },
};

const schemaFAQ = {
  '@context': 'https://schema.org',
  '@type': 'FAQPage',
  mainEntity: content.faqs.map((f) => ({
    '@type': 'Question',
    name: f.question,
    acceptedAnswer: {
      '@type': 'Answer',
      text: f.answer,
    },
  })),
};
---

<Layout
  title={content.title}
  description={content.metaDescription}
>
  <main class="bg-white">
    <!-- 1. Hero do Serviço no Bairro -->
    <section class="relative bg-gradient-to-b from-[#064E3B] via-[#043d2f] to-[#02281e] overflow-hidden py-24 lg:py-32 border-b border-emerald-950 text-white">
      <div class="container mx-auto px-6 lg:px-12 relative z-10">
        <div class="max-w-4xl mx-auto text-center">
          <!-- Breadcrumb -->
          <nav class="flex items-center justify-center flex-wrap gap-2 text-xs font-semibold uppercase tracking-wider text-emerald-200 mb-8" aria-label="Navegação">
            <a href="/" class="hover:text-white transition-colors">Início</a>
            <span>/</span>
            <a href="/bairros" class="hover:text-white transition-colors">Bairros</a>
            <span>/</span>
            <a href={`/bairros/${neighborhood.slug}`} class="hover:text-white transition-colors">{neighborhood.name}</a>
            <span>/</span>
            <span class="text-white font-bold">{service.title}</span>
          </nav>

          <!-- Badges -->
          <div class="flex items-center justify-center flex-wrap gap-3 mb-8">
            <div class="w-11 h-11 rounded-2xl bg-white/10 border border-white/20 backdrop-blur-md text-emerald-300 flex items-center justify-center shrink-0 shadow-lg">
              <ServiceIcon slug={service.slug} class="w-6 h-6" />
            </div>
            <div class="inline-flex items-center gap-2.5 px-5 py-2.5 rounded-full bg-white/10 border border-white/20 backdrop-blur-md shadow-lg">
              <span class="w-2.5 h-2.5 rounded-full bg-emerald-400 animate-pulse"></span>
              <span class="text-xs sm:text-sm font-black text-emerald-200 uppercase tracking-wider">
                {service.badge} • Atendimento no {neighborhood.name}
              </span>
            </div>
          </div>

          <!-- H1 Principal do Serviço no Bairro -->
          <h1 class="text-3xl sm:text-4xl md:text-5xl lg:text-6xl font-black text-white tracking-tighter leading-tight mb-8">
            {content.h1}
          </h1>

          <!-- Texto de Introdução Contextualizado -->
          <p class="text-base sm:text-lg lg:text-xl text-emerald-100 leading-relaxed max-w-3xl mx-auto font-medium mb-10">
            {content.serviceContext}
          </p>

          <!-- Botão WhatsApp Primário -->
          <div class="flex flex-col sm:flex-row items-center justify-center gap-4">
            <a
              href={whatsappServiceUrl}
              target="_blank"
              rel="noopener noreferrer"
              class="w-full sm:w-auto inline-flex items-center justify-center gap-3.5 px-10 py-5 rounded-2xl bg-[#25D366] hover:bg-emerald-500 text-white font-black text-base sm:text-lg shadow-2xl shadow-black/40 transition-all duration-300 hover:scale-105 active:scale-95 border border-emerald-300/30"
            >
              <svg class="w-6 h-6 fill-current shrink-0" viewBox="0 0 24 24">
                <path d="M.057 24l1.687-6.163c-1.041-1.804-1.588-3.849-1.587-5.946.003-6.556 5.338-11.891 11.893-11.891 3.181.001 6.167 1.24 8.413 3.488 2.245 2.248 3.481 5.236 3.48 8.414-.003 6.557-5.338 11.892-11.893 11.892-1.99-.001-3.951-.5-5.688-1.448l-6.305 1.654zm6.597-3.807c1.676.995 3.276 1.591 5.392 1.592 5.448 0 9.886-4.434 9.889-9.885.002-5.462-4.415-9.89-9.881-9.892-5.452 0-9.887 4.434-9.889 9.884-.001 2.225.651 3.891 1.746 5.634l-.999 3.648 3.742-.981zm11.387-5.464c-.074-.124-.272-.198-.57-.347-.297-.149-1.758-.868-2.031-.967-.272-.099-.47-.149-.669.149-.198.297-.768.967-.941 1.165-.173.198-.347.223-.644.074-.297-.149-1.255-.462-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.297-.347.446-.521.151-.172.2-.296.3-.495.099-.198.05-.372-.025-.521-.075-.148-.669-1.611-.916-2.206-.242-.579-.487-.501-.669-.51l-.57-.01c-.198 0-.52.074-.792.372s-1.04 1.016-1.04 2.479 1.065 2.876 1.213 3.074c.149.198 2.095 3.2 5.076 4.487.709.306 1.263.489 1.694.626.712.226 1.36.194 1.872.118.571-.085 1.758-.719 2.006-1.413.248-.695.248-1.29.173-1.414z"/>
              </svg>
              <span>Pedir Orçamento de {service.title} no WhatsApp</span>
            </a>
          </div>
        </div>
      </div>
    </section>

    <!-- 2. Especificações e Características Técnicas -->
    <section class="py-24 lg:py-32 border-b border-gray-100">
      <div class="container mx-auto px-6 lg:px-12 max-w-5xl">
        <div class="text-center max-w-3xl mx-auto mb-16">
          <span class="text-xs font-black uppercase tracking-wider text-secondary mb-3 block">
            Qualidade dos Materiais
          </span>
          <h2 class="text-2xl sm:text-3xl lg:text-4xl font-black text-gray-900 tracking-tight mb-4">
            Diferenciais de {service.title} para Clientes do {neighborhood.name}
          </h2>
          <p class="text-sm sm:text-base text-gray-600 leading-relaxed font-normal">
            Utilizamos vidros homologados pelas normas ABNT e perfis de alumínio reforçados para máxima segurança e durabilidade.
          </p>
        </div>

        <div class="grid grid-cols-1 md:grid-cols-2 gap-6 lg:gap-8 mb-16">
          {service.features.map((feat) => (
            <div class="p-6 rounded-3xl bg-gray-50 border border-gray-100 flex items-start gap-3">
              <span class="w-7 h-7 rounded-full bg-emerald-100 text-secondary flex items-center justify-center shrink-0 font-bold text-sm mt-0.5">
                ✓
              </span>
              <div>
                <strong class="text-sm sm:text-base font-bold text-gray-900 block mb-1">
                  Padrão de Fábrica Homologado
                </strong>
                <span class="text-xs sm:text-sm text-gray-600 leading-relaxed">
                  {feat}
                </span>
              </div>
            </div>
          ))}
        </div>

        <!-- Passo a Passo da Instalação no Bairro -->
        <div class="mt-20 pt-16 border-t border-gray-100">
          <div class="text-center max-w-3xl mx-auto mb-14">
            <h2 class="text-2xl sm:text-3xl font-black text-gray-900 tracking-tight mb-4">
              Como Funciona a Contratação e Instalação no {neighborhood.name}
            </h2>
            <p class="text-sm sm:text-base text-gray-600 leading-relaxed font-normal">
              Atendimento simplificado, transparente e sem burocracia do primeiro contato até o pós-venda.
            </p>
          </div>

          <div class="grid grid-cols-1 md:grid-cols-3 gap-8">
            <div class="p-8 rounded-3xl bg-white border border-gray-200/80 shadow-sm flex flex-col justify-between">
              <div>
                <span class="text-3xl font-black text-secondary block mb-4">01</span>
                <h3 class="text-lg font-black text-gray-900 mb-2 tracking-tight">Medição a Laser Gratuita</h3>
                <p class="text-xs sm:text-sm text-gray-600 leading-relaxed">
                  Agendamos a visita técnica no seu imóvel no {neighborhood.name} para tirar as medidas com trena óptica e analisar o vão sem cobrar visita.
                </p>
              </div>
            </div>

            <div class="p-8 rounded-3xl bg-white border border-gray-200/80 shadow-sm flex flex-col justify-between">
              <div>
                <span class="text-3xl font-black text-secondary block mb-4">02</span>
                <h3 class="text-lg font-black text-gray-900 mb-2 tracking-tight">Fabricação Sob Medida</h3>
                <p class="text-xs sm:text-sm text-gray-600 leading-relaxed">
                  Seus vidros e esquadrias são usinados com corte milimétrico, tratamento térmico de têmpera e perfis com pintura eletrostática.
                </p>
              </div>
            </div>

            <div class="p-8 rounded-3xl bg-white border border-gray-200/80 shadow-sm flex flex-col justify-between">
              <div>
                <span class="text-3xl font-black text-secondary block mb-4">03</span>
                <h3 class="text-lg font-black text-gray-900 mb-2 tracking-tight">Montagem Limpa e Garantia</h3>
                <p class="text-xs sm:text-sm text-gray-600 leading-relaxed">
                  Instalação cuidadosa por profissionais próprios, calafetação com silicone de cura neutra e garantia formal documentada.
                </p>
              </div>
            </div>
          </div>
        </div>
      </div>
    </section>

    <!-- 3. Perguntas Frequentes do Serviço no Bairro -->
    <section class="py-24 lg:py-32 bg-gray-50 border-b border-gray-100">
      <div class="container mx-auto px-6 lg:px-12 max-w-4xl">
        <div class="text-center mb-16">
          <span class="inline-block py-1.5 px-4 rounded-full bg-emerald-50 text-secondary text-xs font-black uppercase tracking-wider mb-4 border border-emerald-200">
            Dúvidas Frequentes
          </span>
          <h2 class="text-3xl sm:text-4xl lg:text-5xl font-black text-gray-900 leading-tight tracking-tighter mb-6">
            Dúvidas sobre {service.title} no {neighborhood.name}
          </h2>
          <p class="text-base sm:text-lg text-gray-600 leading-relaxed font-normal">
            Respostas diretas para tirar dúvidas e solicitar seu orçamento com total segurança.
          </p>
        </div>

        <div class="space-y-4">
          {content.faqs.map((faq) => (
            <details class="group bg-white rounded-2xl p-6 sm:p-8 border border-gray-200/80 shadow-sm open:ring-2 open:ring-secondary/40">
              <summary class="flex items-center justify-between cursor-pointer list-none select-none font-black text-lg text-gray-900 group-hover:text-primary transition-colors">
                <span class="pr-4">{faq.question}</span>
                <span class="w-8 h-8 rounded-full bg-emerald-50 text-secondary group-open:bg-primary group-open:text-white flex items-center justify-center shrink-0 transition-transform duration-300 group-open:rotate-180 text-sm font-bold">
                  ▼
                </span>
              </summary>
              <div class="pt-4 text-gray-600 text-base leading-relaxed font-normal border-t border-gray-100 mt-4">
                <p>{faq.answer}</p>
              </div>
            </details>
          ))}
        </div>

        <!-- Banner de Orçamento WhatsApp -->
        <div class="mt-14 bg-gradient-to-br from-[#064E3B] to-[#02281e] rounded-3xl p-8 sm:p-10 text-white text-center shadow-xl">
          <h3 class="text-2xl sm:text-3xl font-black mb-3 tracking-tight">
            Solicite Agora seu Orçamento de {service.title}
          </h3>
          <p class="text-emerald-100 text-sm sm:text-base mb-8 max-w-2xl mx-auto font-normal leading-relaxed">
            Envie fotos ou medidas aproximadas pelo WhatsApp para receber estimativa sem compromisso no bairro {neighborhood.name}.
          </p>
          <a
            href={whatsappServiceUrl}
            target="_blank"
            rel="noopener noreferrer"
            class="inline-flex items-center gap-3 px-10 py-5 rounded-2xl bg-[#25D366] hover:bg-emerald-500 text-white font-black text-base shadow-xl transition-all duration-300 hover:scale-105 active:scale-95"
          >
            <span>Falar no WhatsApp para o {neighborhood.name}</span>
            <span>→</span>
          </a>
        </div>
      </div>
    </section>

    <!-- 4. Outros Serviços de Vidraçaria no Bairro -->
    <section class="py-24 lg:py-32 bg-white">
      <div class="container mx-auto px-6 lg:px-12 max-w-6xl">
        <div class="text-center max-w-3xl mx-auto mb-16">
          <h3 class="text-2xl sm:text-3xl font-black text-gray-900 tracking-tight mb-4">
            Outros Serviços de Vidraçaria no Bairro {neighborhood.name}
          </h3>
          <p class="text-sm sm:text-base text-gray-600 leading-relaxed font-normal">
            Conheça todas as outras especialidades executadas pela Axis Glass no {neighborhood.name}.
          </p>
        </div>

        <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-6">
          {otherServices.map((outro) => (
            <a
              href={`/bairros/${neighborhood.slug}/${outro.slug}`}
              class="p-7 rounded-3xl border border-gray-200/90 hover:border-primary/50 hover:shadow-xl transition-all duration-300 hover:scale-[1.02] active:scale-95 flex flex-col justify-between group bg-white"
            >
              <div>
                <div class="flex items-center justify-between gap-3 mb-4">
                  <span class="inline-block py-1 px-3 rounded-lg bg-emerald-50 text-secondary border border-emerald-200/80 text-xs font-black uppercase tracking-wide">
                    {outro.badge}
                  </span>
                  <div class="w-12 h-12 rounded-2xl bg-emerald-50 text-secondary border border-emerald-100 flex items-center justify-center shrink-0 group-hover:scale-110 group-hover:bg-primary group-hover:text-white transition-all duration-300 shadow-sm">
                    <ServiceIcon slug={outro.slug} class="w-6 h-6" />
                  </div>
                </div>
                <strong class="text-lg font-black text-gray-900 group-hover:text-primary transition-colors block mb-2 leading-snug tracking-tight">
                  {outro.title}
                </strong>
                <p class="text-sm text-gray-600 line-clamp-3 leading-relaxed font-normal mb-5">
                  {outro.description}
                </p>
              </div>
              <div class="pt-4 border-t border-gray-100 mt-auto flex items-center justify-between font-bold text-xs sm:text-sm text-secondary group-hover:text-primary transition-colors">
                <span>Ver detalhes do serviço</span>
                <span class="w-7 h-7 rounded-full bg-emerald-50 group-hover:bg-primary group-hover:text-white flex items-center justify-center text-xs transition-colors">
                  →
                </span>
              </div>
            </a>
          ))}
        </div>
      </div>
    </section>
  </main>
</Layout>

<!-- JSON-LD Service & FAQ Schema -->
<script type="application/ld+json" set:html={JSON.stringify(schemaService)} />
<script type="application/ld+json" set:html={JSON.stringify(schemaFAQ)} />
