---
import { getCollection } from 'astro:content';
import Layout from '../../layouts/Layout.astro';
import { SITE_CONFIG } from '../../data/config';
import ServiceIcon from '../../components/ServiceIcon.astro';

const services = await getCollection('servicos');
services.sort((a, b) => a.data.order - b.data.order);
---

<Layout
  title={`Nossos Serviços em Vidraçaria | ${SITE_CONFIG.name}`}
  description={`Conheça o catálogo completo de soluções da ${SITE_CONFIG.name} em Uberlândia: esquadrias de alumínio, cortina de vidro, box para banheiro, manutenção especializada e espelhos sob medida.`}
>
  <main class="bg-white">
    <!-- Header Hero Section no Padrão da Home (Verde Esmeralda Nobre) -->
    <section class="relative bg-gradient-to-b from-[#064E3B] via-[#043d2f] to-[#02281e] overflow-hidden py-20 lg:py-28 border-b border-emerald-950 text-white">
      <div class="absolute inset-0 pointer-events-none overflow-hidden">
        <div class="absolute -top-32 -right-32 w-[500px] h-[500px] rounded-full bg-emerald-500/20 blur-3xl"></div>
        <div class="absolute -bottom-32 -left-32 w-[500px] h-[500px] rounded-full bg-green-400/15 blur-3xl"></div>
        <div class="absolute inset-0 bg-[radial-gradient(#ffffff0d_1px,transparent_1px)] [background-size:24px_24px]"></div>
      </div>

      <div class="container mx-auto px-6 lg:px-12 text-center max-w-4xl relative z-10">
        <div class="inline-flex items-center gap-2 px-5 py-2.5 rounded-full bg-white/10 border border-white/20 backdrop-blur-md shadow-lg mb-6">
          <span class="w-2.5 h-2.5 rounded-full bg-emerald-400 animate-pulse"></span>
          <span class="text-xs sm:text-sm font-black text-emerald-200 uppercase tracking-wider">
            Catálogo Especializado em Uberlândia
          </span>
        </div>

        <h1 class="text-3xl sm:text-4xl md:text-5xl lg:text-6xl font-black text-white tracking-tighter leading-tight drop-shadow-sm mb-6">
          Vidros Temperados, Esquadrias e Manutenções
        </h1>

        <p class="text-base sm:text-lg lg:text-xl text-emerald-100 leading-relaxed max-w-2xl mx-auto font-medium">
          Soluções completas para residências, condomínios e empresas executadas com medição técnica a laser, vidros homologados e garantia comprovada.
        </p>
      </div>
    </section>

    <!-- Services Grid Section com Fundo Suave e Cards Ricos e Destacados -->
    <section class="py-24 lg:py-32 bg-gradient-to-b from-gray-50/90 via-emerald-50/30 to-gray-50/90 border-b border-emerald-100/80 relative">
      <div class="container mx-auto px-6 lg:px-12">
        <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-8 lg:gap-10">
          {services.map((service) => (
            <div class="bg-white rounded-3xl p-8 lg:p-10 border-2 border-emerald-100/90 shadow-[0_10px_30px_-5px_rgba(6,78,59,0.07)] hover:shadow-[0_20px_45px_-5px_rgba(6,78,59,0.16)] hover:border-emerald-500/70 transition-all duration-300 hover:-translate-y-1.5 flex flex-col justify-between group relative overflow-hidden">
              <!-- Barra de Destaque Superior do Card -->
              <div class="absolute top-0 left-0 right-0 h-1.5 bg-gradient-to-r from-emerald-600 via-primary to-emerald-400 group-hover:h-2 transition-all"></div>

              <div>
                <!-- Topo do Card: Ícone Especializado + Badge -->
                <div class="flex items-center justify-between gap-4 mb-6 pt-1">
                  <div class="w-14 h-14 rounded-2xl bg-emerald-50 text-secondary border border-emerald-200/80 flex items-center justify-center shadow-sm group-hover:scale-110 group-hover:bg-[#064E3B] group-hover:text-emerald-300 transition-all duration-300 shrink-0">
                    <ServiceIcon slug={service.slug} class="w-7 h-7" />
                  </div>

                  <span class="inline-block py-1.5 px-3 rounded-xl bg-emerald-50 text-secondary border border-emerald-200/90 text-xs font-black uppercase tracking-wider shadow-xs">
                    {service.data.badge}
                  </span>
                </div>

                <!-- Título do Serviço -->
                <h2 class="text-xl sm:text-2xl font-black text-gray-900 leading-tight mb-4 group-hover:text-primary transition-colors tracking-tight">
                  <a href={`/servicos/${service.slug}`}>
                    {service.data.title}
                  </a>
                </h2>

                <!-- Descrição com Leitura Fluida -->
                <p class="text-gray-600 text-sm sm:text-base leading-relaxed mb-6 font-normal">
                  {service.data.description}
                </p>

                <!-- Checklist Organizado em Blocos Legíveis -->
                {service.data.features && service.data.features.length > 0 && (
                  <ul class="space-y-2.5 mb-8">
                    {service.data.features.slice(0, 3).map((feature) => (
                      <li class="flex items-start gap-2.5 p-2.5 rounded-xl bg-emerald-50/50 border border-emerald-100/80 text-xs sm:text-sm text-gray-800 font-medium group-hover:bg-emerald-50/80 transition-colors">
                        <span class="w-5 h-5 rounded-lg bg-emerald-200/80 text-secondary flex items-center justify-center shrink-0 mt-0.5 text-xs font-black">✓</span>
                        <span class="leading-snug">{feature}</span>
                      </li>
                    ))}
                  </ul>
                )}
              </div>

              <!-- Ações do Card -->
              <div class="pt-6 border-t border-emerald-100/80 flex flex-col gap-3">
                <a
                  href={`/servicos/${service.slug}`}
                  class="inline-flex items-center justify-between font-black text-xs sm:text-sm text-secondary hover:text-primary transition-colors"
                >
                  <span>Ver Especificações Técnicas</span>
                  <span class="group-hover:translate-x-1.5 transition-transform">→</span>
                </a>
                <a
                  href={SITE_CONFIG.whatsappUrl}
                  target="_blank"
                  rel="noopener noreferrer"
                  class="inline-flex items-center justify-center gap-2 w-full p-4 rounded-xl bg-emerald-50 hover:bg-[#25D366] text-secondary hover:text-white text-xs font-black transition-all duration-300 hover:scale-105 active:scale-95 border border-emerald-200 hover:border-[#25D366]"
                >
                  <svg class="w-4 h-4 fill-current shrink-0" viewBox="0 0 24 24">
                    <path d="M.057 24l1.687-6.163c-1.041-1.804-1.588-3.849-1.587-5.946.003-6.556 5.338-11.891 11.893-11.891 3.181.001 6.167 1.24 8.413 3.488 2.245 2.248 3.481 5.236 3.48 8.414-.003 6.557-5.338 11.892-11.893 11.892-1.99-.001-3.951-.5-5.688-1.448l-6.305 1.654zm6.597-3.807c1.676.995 3.276 1.591 5.392 1.592 5.448 0 9.886-4.434 9.889-9.885.002-5.462-4.415-9.89-9.881-9.892-5.452 0-9.887 4.434-9.889 9.884-.001 2.225.651 3.891 1.746 5.634l-.999 3.648 3.742-.981zm11.387-5.464c-.074-.124-.272-.198-.57-.347-.297-.149-1.758-.868-2.031-.967-.272-.099-.47-.149-.669.149-.198.297-.768.967-.941 1.165-.173.198-.347.223-.644.074-.297-.149-1.255-.462-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.297-.347.446-.521.151-.172.2-.296.3-.495.099-.198.05-.372-.025-.521-.075-.148-.669-1.611-.916-2.206-.242-.579-.487-.501-.669-.51l-.57-.01c-.198 0-.52.074-.792.372s-1.04 1.016-1.04 2.479 1.065 2.876 1.213 3.074c.149.198 2.095 3.2 5.076 4.487.709.306 1.263.489 1.694.626.712.226 1.36.194 1.872.118.571-.085 1.758-.719 2.006-1.413.248-.695.248-1.29.173-1.414z"/>
                  </svg>
                  <span>Orçamento no WhatsApp</span>
                </a>
              </div>
            </div>
          ))}
        </div>

        <!-- Banner de Conversão no Padrão da Home: Verde Esmeralda e WhatsApp -->
        <div class="mt-24 bg-gradient-to-br from-[#064E3B] via-[#043d2f] to-[#02281e] rounded-3xl p-8 sm:p-10 lg:p-14 text-white text-center max-w-4xl mx-auto shadow-2xl border border-emerald-800">
          <span class="text-xs uppercase tracking-widest font-black text-emerald-300 block mb-3">
            Atendimento Personalizado em Uberlândia
          </span>
          <h3 class="text-2xl sm:text-3xl font-black text-white mb-4 tracking-tight">
            Precisa de um Projeto Personalizado ou Manutenção?
          </h3>
          <p class="text-emerald-100 text-base max-w-xl mx-auto mb-8 font-normal">
            Fabricamos soluções sob medida e realizamos assistência técnica para residências, condomínios e comércios em todos os bairros de Uberlândia.
          </p>
          <a
            href={SITE_CONFIG.whatsappUrl}
            target="_blank"
            rel="noopener noreferrer"
            class="inline-flex items-center justify-center gap-3.5 px-10 py-5 rounded-2xl bg-[#25D366] hover:bg-emerald-500 text-white font-black text-base shadow-xl transition-all duration-300 hover:scale-105 active:scale-95 border border-emerald-300/30"
          >
            <svg class="w-6 h-6 fill-current shrink-0" viewBox="0 0 24 24">
              <path d="M.057 24l1.687-6.163c-1.041-1.804-1.588-3.849-1.587-5.946.003-6.556 5.338-11.891 11.893-11.891 3.181.001 6.167 1.24 8.413 3.488 2.245 2.248 3.481 5.236 3.48 8.414-.003 6.557-5.338 11.892-11.893 11.892-1.99-.001-3.951-.5-5.688-1.448l-6.305 1.654zm6.597-3.807c1.676.995 3.276 1.591 5.392 1.592 5.448 0 9.886-4.434 9.889-9.885.002-5.462-4.415-9.89-9.881-9.892-5.452 0-9.887 4.434-9.889 9.884-.001 2.225.651 3.891 1.746 5.634l-.999 3.648 3.742-.981zm11.387-5.464c-.074-.124-.272-.198-.57-.347-.297-.149-1.758-.868-2.031-.967-.272-.099-.47-.149-.669.149-.198.297-.768.967-.941 1.165-.173.198-.347.223-.644.074-.297-.149-1.255-.462-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.297-.347.446-.521.151-.172.2-.296.3-.495.099-.198.05-.372-.025-.521-.075-.148-.669-1.611-.916-2.206-.242-.579-.487-.501-.669-.51l-.57-.01c-.198 0-.52.074-.792.372s-1.04 1.016-1.04 2.479 1.065 2.876 1.213 3.074c.149.198 2.095 3.2 5.076 4.487.709.306 1.263.489 1.694.626.712.226 1.36.194 1.872.118.571-.085 1.758-.719 2.006-1.413.248-.695.248-1.29.173-1.414z"/>
            </svg>
            <span>Falar com Projetista pelo WhatsApp</span>
          </a>
        </div>
      </div>
    </section>
  </main>
</Layout>
