---
import { getCollection } from 'astro:content';
import Layout from '../../layouts/Layout.astro';
import { SITE_CONFIG } from '../../data/config';
import ServiceIcon from '../../components/ServiceIcon.astro';

export const prerender = true;

export async function getStaticPaths() {
  const servicos = await getCollection('servicos');
  return servicos.map((entry) => ({
    params: { slug: entry.slug },
    props: { entry },
  }));
}

const { entry } = Astro.props;
const { Content } = await entry.render();

const allServices = await getCollection('servicos');
const otherServices = allServices.filter((s) => s.slug !== entry.slug);

const whatsappServiceUrl = `https://wa.me/${SITE_CONFIG.whatsappRaw}?text=${encodeURIComponent(
  `Olá, vim do site Vidraçaria Axis Glass e gostaria de solicitar um orçamento sem compromisso de ${entry.data.title} em Uberlândia.`
)}`;

const techSpecs = [
  {
    icon: '🛡️',
    label: 'Material Homologado',
    value: 'Vidro Temperado ou Laminado Certificado Inmetro',
    desc: 'Alta resistência a impactos e máxima segurança térmica.',
  },
  {
    icon: '📏',
    label: 'Espessuras Disponíveis',
    value: '8mm, 10mm ou Laminado Duplo de Segurança',
    desc: 'Dimensionado conforme as exigências da norma e vão do vão.',
  },
  {
    icon: '⚙️',
    label: 'Ferragens & Perfis',
    value: 'Alumínio Linha Nobre / Aço Inoxidável 304',
    desc: 'Perfis anticorrosivos com pintura eletrostática de longa vida.',
  },
  {
    icon: '📋',
    label: 'Normas ABNT Atendidas',
    value: 'NBR 14207, 14718, 16259 e 10821',
    desc: 'Rigidez estrutural, atenuação acústica e estanqueidade comprovada.',
  },
  {
    icon: '🎨',
    label: 'Cores de Perfis e Vidros',
    value: 'Preto Fosco, Cromado, Branco, Champagne e Bronze',
    desc: 'Vidros incolor, verde, fumê, bronze ou jateados com privacidade.',
  },
  {
    icon: '🤝',
    label: 'Garantia e Assistência',
    value: 'Garantia Técnica com Suporte Local em Uberlândia',
    desc: 'Regulagem pós-instalação, vedação completa e assistência ágil.',
  },
];

const applications = [
  {
    icon: '🏡',
    title: 'Residências e Sobrados',
    tag: 'Alto Padrão',
    desc: 'Integração de varandas, áreas gourmet e salas de estar com iluminação natural, vista aberta e requinte arquitetônico.',
  },
  {
    icon: '🏢',
    title: 'Apartamentos e Condomínios',
    tag: 'Fechamento Seguro',
    desc: 'Atenuação acústica eficiente, bloqueio de vento e chuvas, e valorização imediata do imóvel em condomínios de Uberlândia.',
  },
  {
    icon: '💼',
    title: 'Espaços Comerciais e Clínicas',
    tag: 'Corporativo',
    desc: 'Fachadas, escritórios executivos e consultórios que exigem sofisticação, higiene, claridade e isolamento sonoro.',
  },
];

const differentials = [
  {
    step: '01',
    title: 'Medição a Laser no Local',
    desc: 'Aferição milimétrica sem taxa de visita em qualquer bairro de Uberlândia para caimento perfeito e vedação impecável.',
  },
  {
    step: '02',
    title: 'Materiais com Selo Inmetro',
    desc: 'Vidros e ligas metálicas com procedência de fábrica rastreada e certificados de segurança contra impactos.',
  },
  {
    step: '03',
    title: 'Instalação Própria Especializada',
    desc: 'Equipe própria da Axis Glass com anos de experiência, ferramentas de precisão e furação com aspiração sem sujeira.',
  },
  {
    step: '04',
    title: 'Garantia e Suporte Permanente',
    desc: 'Compromisso formal com assistência técnica no Tubalina e deslocamento rápido para regulagens periódicas.',
  },
];

const schemaService = {
  '@context': 'https://schema.org',
  '@type': 'Service',
  name: entry.data.title,
  description: entry.data.description,
  provider: {
    '@type': 'LocalBusiness',
    name: SITE_CONFIG.name,
    telephone: SITE_CONFIG.whatsapp,
    address: {
      '@type': 'PostalAddress',
      streetAddress: SITE_CONFIG.address.streetAddress,
      addressLocality: 'Uberlândia',
      addressRegion: 'MG',
      addressCountry: 'BR',
    },
  },
  areaServed: {
    '@type': 'City',
    name: 'Uberlândia',
  },
};
---

<Layout
  title={`${entry.data.metaTitle || entry.data.title} | ${SITE_CONFIG.name}`}
  description={entry.data.metaDescription || entry.data.description}
>
  <main class="bg-white">
    <!-- 1. Hero do Serviço no Padrão da Home (Verde Esmeralda Nobre) -->
    <section class="relative bg-gradient-to-b from-[#064E3B] via-[#043d2f] to-[#02281e] overflow-hidden py-20 lg:py-28 border-b border-emerald-950 text-white">
      <!-- Efeitos de Iluminação e Brilho Suave -->
      <div class="absolute inset-0 pointer-events-none overflow-hidden">
        <div class="absolute -top-32 -right-32 w-[500px] h-[500px] rounded-full bg-emerald-500/20 blur-3xl"></div>
        <div class="absolute -bottom-32 -left-32 w-[500px] h-[500px] rounded-full bg-green-400/15 blur-3xl"></div>
        <div class="absolute inset-0 bg-[radial-gradient(#ffffff0d_1px,transparent_1px)] [background-size:24px_24px]"></div>
      </div>

      <div class="container mx-auto px-6 lg:px-12 relative z-10">
        <div class="max-w-4xl mx-auto text-center">
          <!-- Breadcrumb de Navegação -->
          <nav class="flex items-center justify-center flex-wrap gap-2 text-xs font-semibold uppercase tracking-wider text-emerald-200/80 mb-6" aria-label="Navegação">
            <a href="/" class="hover:text-white transition-colors">Início</a>
            <span>/</span>
            <a href="/servicos" class="hover:text-white transition-colors">Serviços</a>
            <span>/</span>
            <span class="text-white font-bold">{entry.data.title}</span>
          </nav>

          <!-- Selo com Ícone do Serviço e Badge -->
          <div class="flex items-center justify-center flex-wrap gap-3 mb-6">
            <div class="w-14 h-14 rounded-2xl bg-white/10 border border-white/20 backdrop-blur-md text-emerald-300 flex items-center justify-center shrink-0 shadow-lg">
              <ServiceIcon slug={entry.slug} class="w-7 h-7" />
            </div>
            <div class="inline-flex items-center gap-2 px-5 py-2.5 rounded-full bg-white/10 border border-white/20 backdrop-blur-md shadow-lg">
              <span class="w-2.5 h-2.5 rounded-full bg-emerald-400 animate-pulse"></span>
              <span class="text-xs sm:text-sm font-black text-emerald-200 uppercase tracking-wider">
                {entry.data.badge} • Instalação em Toda Uberlândia
              </span>
            </div>
          </div>

          <!-- Título H1 Principal -->
          <h1 class="text-3xl sm:text-4xl md:text-5xl lg:text-6xl font-black text-white tracking-tighter leading-tight drop-shadow-sm mb-6">
            {entry.data.title}
          </h1>

          <!-- Descrição de Introdução com Alto Contraste -->
          <p class="text-base sm:text-lg lg:text-xl text-emerald-100 leading-relaxed max-w-3xl mx-auto font-medium mb-8">
            {entry.data.description}
          </p>

          <!-- Destaques Rápidos do Serviço em Pílulas Visuais -->
          {entry.data.features && entry.data.features.length > 0 && (
            <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-3 max-w-3xl mx-auto mb-10 text-left">
              {entry.data.features.map((feat) => (
                <div class="flex items-center gap-3 p-3 rounded-2xl bg-white/10 border border-white/15 backdrop-blur-md text-white text-xs sm:text-sm font-medium">
                  <span class="w-5 h-5 rounded-full bg-emerald-400 text-[#064E3B] flex items-center justify-center font-black text-xs shrink-0">
                    ✓
                  </span>
                  <span class="leading-snug">{feat}</span>
                </div>
              ))}
            </div>
          )}

          <!-- Botão WhatsApp Primário -->
          <div class="flex flex-col sm:flex-row items-center justify-center gap-4">
            <a
              href={whatsappServiceUrl}
              target="_blank"
              rel="noopener noreferrer"
              class="w-full sm:w-auto inline-flex items-center justify-center gap-3.5 px-10 py-5 rounded-2xl bg-[#25D366] hover:bg-emerald-500 text-white font-black text-base sm:text-lg shadow-2xl shadow-black/40 transition-all duration-300 hover:scale-105 active:scale-95 border border-emerald-300/30"
            >
              <svg class="w-6 h-6 fill-current shrink-0" viewBox="0 0 24 24">
                <path d="M.057 24l1.687-6.163c-1.041-1.804-1.588-3.849-1.587-5.946.003-6.556 5.338-11.891 11.893-11.891 3.181.001 6.167 1.24 8.413 3.488 2.245 2.248 3.481 5.236 3.48 8.414-.003 6.557-5.338 11.892-11.893 11.892-1.99-.001-3.951-.5-5.688-1.448l-6.305 1.654zm6.597-3.807c1.676.995 3.276 1.591 5.392 1.592 5.448 0 9.886-4.434 9.889-9.885.002-5.462-4.415-9.89-9.881-9.892-5.452 0-9.887 4.434-9.889 9.884-.001 2.225.651 3.891 1.746 5.634l-.999 3.648 3.742-.981zm11.387-5.464c-.074-.124-.272-.198-.57-.347-.297-.149-1.758-.868-2.031-.967-.272-.099-.47-.149-.669.149-.198.297-.768.967-.941 1.165-.173.198-.347.223-.644.074-.297-.149-1.255-.462-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.297-.347.446-.521.151-.172.2-.296.3-.495.099-.198.05-.372-.025-.521-.075-.148-.669-1.611-.916-2.206-.242-.579-.487-.501-.669-.51l-.57-.01c-.198 0-.52.074-.792.372s-1.04 1.016-1.04 2.479 1.065 2.876 1.213 3.074c.149.198 2.095 3.2 5.076 4.487.709.306 1.263.489 1.694.626.712.226 1.36.194 1.872.118.571-.085 1.758-.719 2.006-1.413.248-.695.248-1.29.173-1.414z"/>
              </svg>
              <span>Solicitar Orçamento no WhatsApp</span>
            </a>
          </div>
        </div>
      </div>
    </section>

    <!-- 2. Conteúdo Central: Layout Organizado em 2 Colunas com Foco Total na Leitura -->
    <section class="py-16 lg:py-24 bg-white border-b border-gray-100">
      <div class="container mx-auto px-6 lg:px-12 max-w-6xl">
        <div class="grid grid-cols-1 lg:grid-cols-12 gap-12 lg:gap-16 items-start">
          
          <!-- Coluna Principal (8 Colunas): Artigo Estruturado e Escaneável -->
          <div class="lg:col-span-8">
            
            <!-- Box de Destaque Editorial Superior -->
            <div class="p-6 sm:p-8 rounded-3xl bg-emerald-50/50 border border-emerald-100 mb-10 flex items-start gap-4">
              <div class="w-12 h-12 rounded-2xl bg-white text-secondary flex items-center justify-center shrink-0 border border-emerald-200 shadow-sm text-2xl">
                ✨
              </div>
              <div>
                <span class="text-xs font-black uppercase text-secondary tracking-wider block mb-1">
                  Padrão Axis Glass Uberlândia
                </span>
                <h2 class="text-lg sm:text-xl font-black text-gray-900 tracking-tight mb-2">
                  Soluções Sob Medida com Rigor Técnico e Segurança Comprovada
                </h2>
                <p class="text-sm text-gray-600 leading-relaxed font-normal">
                  Cada instalação é planejada com medição técnica a laser, vidros certificados pelo Inmetro e acabamento minucioso que valoriza a estética e a proteção do seu imóvel.
                </p>
              </div>
            </div>

            <!-- Artigo Markdown com Estilização Customizada de Leitura -->
            <article class="service-content">
              <Content />
            </article>

            <!-- Box de Compromisso Técnico Inferior -->
            <div class="mt-12 p-6 sm:p-8 rounded-3xl bg-gradient-to-r from-emerald-900 to-[#064E3B] text-white shadow-xl flex flex-col sm:flex-row items-center justify-between gap-6">
              <div>
                <span class="text-xs font-black uppercase text-emerald-300 tracking-wider block mb-1">
                  Atendimento em Domicílio
                </span>
                <h3 class="text-xl font-black text-white tracking-tight mb-1">
                  Deseja uma Avaliação Técnica no Seu Imóvel?
                </h3>
                <p class="text-xs sm:text-sm text-emerald-100 font-normal">
                  Agende a visita sem custos adicionais em qualquer setor ou bairro de Uberlândia.
                </p>
              </div>
              <a
                href={whatsappServiceUrl}
                target="_blank"
                rel="noopener noreferrer"
                class="inline-flex items-center gap-2 px-6 py-3.5 rounded-xl bg-[#25D366] hover:bg-emerald-500 text-white font-bold text-sm shrink-0 shadow-lg transition-transform hover:scale-105 active:scale-95"
              >
                <span>Agendar Medição</span>
                <span>→</span>
              </a>
            </div>
          </div>

          <!-- Coluna Lateral (4 Colunas): Sidebar Fixa de Apoio e Confiança -->
          <div class="lg:col-span-4 space-y-6 lg:sticky lg:top-28">
            
            <!-- Card de Contato e Orçamento Rápido -->
            <div class="bg-white rounded-3xl p-7 border border-emerald-100 shadow-xl relative overflow-hidden">
              <div class="w-12 h-12 rounded-2xl bg-emerald-50 text-secondary flex items-center justify-center mb-5 border border-emerald-100">
                <ServiceIcon slug={entry.slug} class="w-6 h-6" />
              </div>

              <span class="text-xs font-black uppercase tracking-wider text-secondary block mb-1">
                Atendimento Direto
              </span>
              <h3 class="text-xl font-black text-gray-900 tracking-tight mb-3">
                Solicite seu Orçamento de {entry.data.title}
              </h3>
              <p class="text-xs sm:text-sm text-gray-600 leading-relaxed mb-6 font-normal">
                Envie fotos, medidas ou tire dúvidas diretamente pelo WhatsApp com nossa equipe técnica.
              </p>

              <!-- Lista de Facilidades -->
              <ul class="space-y-3 mb-6 text-xs text-gray-700 font-medium">
                <li class="flex items-center gap-2.5">
                  <span class="w-5 h-5 rounded-full bg-emerald-100 text-secondary flex items-center justify-center text-[10px] font-black shrink-0">✓</span>
                  <span>Medição técnica a laser gratuita</span>
                </li>
                <li class="flex items-center gap-2.5">
                  <span class="w-5 h-5 rounded-full bg-emerald-100 text-secondary flex items-center justify-center text-[10px] font-black shrink-0">✓</span>
                  <span>Orçamento detalhado sem compromisso</span>
                </li>
                <li class="flex items-center gap-2.5">
                  <span class="w-5 h-5 rounded-full bg-emerald-100 text-secondary flex items-center justify-center text-[10px] font-black shrink-0">✓</span>
                  <span>Vidros temperados com selo Inmetro</span>
                </li>
                <li class="flex items-center gap-2.5">
                  <span class="w-5 h-5 rounded-full bg-emerald-100 text-secondary flex items-center justify-center text-[10px] font-black shrink-0">✓</span>
                  <span>Garantia formal de estanqueidade</span>
                </li>
              </ul>

              <!-- Botão WhatsApp -->
              <a
                href={whatsappServiceUrl}
                target="_blank"
                rel="noopener noreferrer"
                class="w-full inline-flex items-center justify-center gap-3 px-6 py-4 rounded-2xl bg-[#25D366] hover:bg-emerald-500 text-white font-black text-sm shadow-lg transition-all duration-300 hover:scale-[1.02] active:scale-95"
              >
                <svg class="w-5 h-5 fill-current shrink-0" viewBox="0 0 24 24">
                  <path d="M.057 24l1.687-6.163c-1.041-1.804-1.588-3.849-1.587-5.946.003-6.556 5.338-11.891 11.893-11.891 3.181.001 6.167 1.24 8.413 3.488 2.245 2.248 3.481 5.236 3.48 8.414-.003 6.557-5.338 11.892-11.893 11.892-1.99-.001-3.951-.5-5.688-1.448l-6.305 1.654zm6.597-3.807c1.676.995 3.276 1.591 5.392 1.592 5.448 0 9.886-4.434 9.889-9.885.002-5.462-4.415-9.89-9.881-9.892-5.452 0-9.887 4.434-9.889 9.884-.001 2.225.651 3.891 1.746 5.634l-.999 3.648 3.742-.981zm11.387-5.464c-.074-.124-.272-.198-.57-.347-.297-.149-1.758-.868-2.031-.967-.272-.099-.47-.149-.669.149-.198.297-.768.967-.941 1.165-.173.198-.347.223-.644.074-.297-.149-1.255-.462-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.297-.347.446-.521.151-.172.2-.296.3-.495.099-.198.05-.372-.025-.521-.075-.148-.669-1.611-.916-2.206-.242-.579-.487-.501-.669-.51l-.57-.01c-.198 0-.52.074-.792.372s-1.04 1.016-1.04 2.479 1.065 2.876 1.213 3.074c.149.198 2.095 3.2 5.076 4.487.709.306 1.263.489 1.694.626.712.226 1.36.194 1.872.118.571-.085 1.758-.719 2.006-1.413.248-.695.248-1.29.173-1.414z"/>
                </svg>
                <span>Falar com o Vidraceiro</span>
              </a>
            </div>

            <!-- Card de Localização e Confiabilidade -->
            <div class="bg-gray-50 rounded-3xl p-6 border border-gray-200/80 text-xs text-gray-600">
              <span class="font-black text-gray-900 block mb-2 text-sm">
                Sede da Vidraçaria em Uberlândia
              </span>
              <p class="mb-3 leading-relaxed">
                {SITE_CONFIG.address.fullFormatted}. Atendimento ágil para vistorias em toda a cidade e região.
              </p>
              <div class="flex items-center gap-2 text-secondary font-bold">
                <span>WhatsApp:</span>
                <span>{SITE_CONFIG.whatsapp}</span>
              </div>
            </div>
          </div>

        </div>
      </div>
    </section>

    <!-- 3. Ficha Técnica dos Materiais e Normas ABNT (Padrão de Cores Home) -->
    <section class="py-20 lg:py-28 bg-emerald-50/40 border-b border-emerald-100">
      <div class="container mx-auto px-6 lg:px-12 max-w-6xl">
        <div class="text-center max-w-3xl mx-auto mb-16">
          <span class="inline-block py-1.5 px-4 rounded-full bg-emerald-100 text-secondary text-xs font-black uppercase tracking-wider mb-4 border border-emerald-200">
            Ficha Técnica & Homologação
          </span>
          <h2 class="text-3xl sm:text-4xl font-black text-gray-900 tracking-tight mb-4">
            Especificações dos Materiais de {entry.data.title}
          </h2>
          <p class="text-sm sm:text-base text-gray-600 leading-relaxed font-normal">
            Trabalhamos exclusivamente com componentes de primeira linha certificados para garantir resistência mecânica, durabilidade e segurança total.
          </p>
        </div>

        <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6">
          {techSpecs.map((spec) => (
            <div class="p-7 rounded-3xl bg-white border border-emerald-100 shadow-sm hover:shadow-xl hover:border-primary/40 transition-all duration-300 flex flex-col justify-between group">
              <div>
                <div class="flex items-center justify-between mb-4">
                  <span class="text-2xl">{spec.icon}</span>
                  <span class="text-[10px] font-black uppercase tracking-wider text-secondary bg-emerald-50 px-2.5 py-1 rounded-md border border-emerald-200">
                    Certificado
                  </span>
                </div>
                <span class="text-xs uppercase font-bold text-gray-500 block mb-1.5">
                  {spec.label}
                </span>
                <h3 class="text-base sm:text-lg font-black text-gray-900 leading-snug mb-2 group-hover:text-primary transition-colors">
                  {spec.value}
                </h3>
              </div>
              <p class="text-xs text-gray-600 leading-relaxed pt-3 border-t border-gray-100 mt-2 font-normal">
                {spec.desc}
              </p>
            </div>
          ))}
        </div>
      </div>
    </section>

    <!-- 4. Ambientes e Aplicações do Serviço -->
    <section class="py-20 lg:py-28 bg-white border-b border-gray-100">
      <div class="container mx-auto px-6 lg:px-12 max-w-6xl">
        <div class="text-center max-w-3xl mx-auto mb-16">
          <span class="inline-block py-1.5 px-4 rounded-full bg-emerald-50 text-secondary text-xs font-black uppercase tracking-wider mb-4 border border-emerald-200">
            Aplicações Versáteis
          </span>
          <h2 class="text-3xl sm:text-4xl font-black text-gray-900 tracking-tight mb-4">
            Onde {entry.data.title} se Destaca
          </h2>
          <p class="text-sm sm:text-base text-gray-600 leading-relaxed font-normal">
            Projetos adaptados para diferentes perfis de imóveis residenciais, condomínios verticais e ambientes corporativos em Uberlândia.
          </p>
        </div>

        <div class="grid grid-cols-1 md:grid-cols-3 gap-8">
          {applications.map((app) => (
            <div class="p-8 rounded-3xl border border-emerald-100/80 bg-white shadow-sm hover:shadow-2xl transition-all duration-300 hover:scale-[1.02] flex flex-col justify-between group">
              <div>
                <div class="w-14 h-14 rounded-2xl bg-emerald-50 text-2xl flex items-center justify-center mb-6 border border-emerald-100 group-hover:scale-110 transition-transform">
                  {app.icon}
                </div>
                <span class="text-[10px] font-black uppercase tracking-wider text-secondary block mb-1">
                  {app.tag}
                </span>
                <h3 class="text-xl font-black text-gray-900 mb-3 tracking-tight group-hover:text-primary transition-colors">
                  {app.title}
                </h3>
                <p class="text-sm text-gray-600 leading-relaxed font-normal">
                  {app.desc}
                </p>
              </div>
            </div>
          ))}
        </div>
      </div>
    </section>

    <!-- 5. Diferenciais Técnicos da Instalação (Padrão Dark Green da Home) -->
    <section class="bg-gradient-to-b from-[#064E3B] via-[#043d2f] to-[#064E3B] text-white py-20 lg:py-28 border-b border-emerald-950 relative overflow-hidden">
      <div class="container mx-auto px-6 lg:px-12 max-w-6xl relative z-10">
        <div class="max-w-3xl mx-auto text-center mb-16">
          <span class="text-xs font-black uppercase tracking-wider text-emerald-300 mb-3 block">
            Garantia de Execução Perfeita
          </span>
          <h2 class="text-3xl sm:text-4xl lg:text-5xl font-black text-white leading-tight tracking-tighter mb-6">
            Por Que Fazer {entry.data.title} com a Axis Glass?
          </h2>
          <p class="text-base sm:text-lg text-emerald-100 leading-relaxed font-normal">
            Do primeiro contato ao acabamento da montagem, tratamos seu projeto com precisão técnica e transparência absoluta.
          </p>
        </div>

        <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-6">
          {differentials.map((diff) => (
            <div class="p-8 rounded-3xl bg-white/10 border border-white/15 backdrop-blur-md shadow-lg flex flex-col justify-between group hover:bg-white/15 transition-all">
              <div>
                <span class="text-3xl font-black text-emerald-300 block mb-4">
                  {diff.step}
                </span>
                <h3 class="text-lg font-black text-white mb-2 tracking-tight">
                  {diff.title}
                </h3>
                <p class="text-xs sm:text-sm text-emerald-100 leading-relaxed font-normal">
                  {diff.desc}
                </p>
              </div>
            </div>
          ))}
        </div>
      </div>
    </section>

    <!-- 6. Banner de Fechamento / Conversão no Padrão Verde Esmeralda da Home -->
    <section class="py-20 lg:py-28 bg-white border-b border-gray-100">
      <div class="container mx-auto px-6 lg:px-12 max-w-5xl">
        <div class="bg-gradient-to-br from-[#064E3B] via-[#043d2f] to-[#02281e] rounded-3xl p-10 lg:p-14 text-white text-center shadow-2xl relative overflow-hidden border border-emerald-800">
          <div class="max-w-3xl mx-auto relative z-10">
            <span class="text-xs uppercase tracking-widest font-black text-emerald-300 block mb-3">
              Orçamento Rápido em Uberlândia
            </span>
            <h2 class="text-2xl sm:text-3xl lg:text-4xl font-black text-white leading-tight mb-4 tracking-tighter">
              Solicite Agora seu Orçamento de <span class="text-emerald-300">{entry.data.title}</span>
            </h2>
            <p class="text-emerald-100 text-base sm:text-lg mb-10 leading-relaxed font-normal">
              Receba orientações técnicas, consulte amostras de perfis e agende a visita com medição a laser no seu imóvel sem qualquer custo em Uberlândia.
            </p>
            
            <div class="flex flex-col sm:flex-row items-center justify-center gap-4">
              <a
                href={whatsappServiceUrl}
                target="_blank"
                rel="noopener noreferrer"
                class="w-full sm:w-auto inline-flex items-center justify-center gap-3.5 px-10 py-5 rounded-2xl bg-[#25D366] hover:bg-emerald-500 text-white font-black text-base sm:text-lg shadow-xl shadow-black/30 transition-all duration-300 hover:scale-105 active:scale-95 border border-emerald-300/30"
              >
                <svg class="w-6 h-6 fill-current shrink-0" viewBox="0 0 24 24">
                  <path d="M.057 24l1.687-6.163c-1.041-1.804-1.588-3.849-1.587-5.946.003-6.556 5.338-11.891 11.893-11.891 3.181.001 6.167 1.24 8.413 3.488 2.245 2.248 3.481 5.236 3.48 8.414-.003 6.557-5.338 11.892-11.893 11.892-1.99-.001-3.951-.5-5.688-1.448l-6.305 1.654zm6.597-3.807c1.676.995 3.276 1.591 5.392 1.592 5.448 0 9.886-4.434 9.889-9.885.002-5.462-4.415-9.89-9.881-9.892-5.452 0-9.887 4.434-9.889 9.884-.001 2.225.651 3.891 1.746 5.634l-.999 3.648 3.742-.981zm11.387-5.464c-.074-.124-.272-.198-.57-.347-.297-.149-1.758-.868-2.031-.967-.272-.099-.47-.149-.669.149-.198.297-.768.967-.941 1.165-.173.198-.347.223-.644.074-.297-.149-1.255-.462-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.297-.347.446-.521.151-.172.2-.296.3-.495.099-.198.05-.372-.025-.521-.075-.148-.669-1.611-.916-2.206-.242-.579-.487-.501-.669-.51l-.57-.01c-.198 0-.52.074-.792.372s-1.04 1.016-1.04 2.479 1.065 2.876 1.213 3.074c.149.198 2.095 3.2 5.076 4.487.709.306 1.263.489 1.694.626.712.226 1.36.194 1.872.118.571-.085 1.758-.719 2.006-1.413.248-.695.248-1.29.173-1.414z"/>
                </svg>
                <span>Chamar no WhatsApp Agora</span>
              </a>
            </div>
          </div>
        </div>
      </div>
    </section>

    <!-- 7. Outros Serviços de Vidraçaria Disponíveis -->
    <section class="py-20 lg:py-28 bg-gray-50/70">
      <div class="container mx-auto px-6 lg:px-12 max-w-6xl">
        <div class="text-center max-w-3xl mx-auto mb-16">
          <span class="inline-block py-1 px-3 rounded-lg bg-emerald-50 text-secondary text-xs font-black uppercase tracking-wider mb-3 border border-emerald-200">
            Catálogo Geral
          </span>
          <h3 class="text-2xl sm:text-3xl font-black text-gray-900 tracking-tight mb-3">
            Outros Serviços Disponíveis em Uberlândia
          </h3>
          <p class="text-sm text-gray-600 leading-relaxed font-normal">
            Conheça todas as especialidades executadas com maestria pela Axis Glass.
          </p>
        </div>

        <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-6">
          {otherServices.slice(0, 6).map((service) => (
            <a
              href={`/servicos/${service.slug}`}
              class="p-6 rounded-3xl border border-gray-200/80 bg-white hover:border-primary/40 hover:shadow-xl transition-all duration-300 hover:scale-[1.02] active:scale-95 flex flex-col justify-between group"
            >
              <div>
                <div class="flex items-center justify-between gap-3 mb-4">
                  <div class="w-12 h-12 rounded-2xl bg-emerald-50 text-secondary border border-emerald-100 flex items-center justify-center shrink-0 group-hover:scale-110 group-hover:bg-primary group-hover:text-white transition-all duration-300 shadow-sm">
                    <ServiceIcon slug={service.slug} class="w-6 h-6" />
                  </div>
                  <span class="text-[10px] font-black text-secondary uppercase tracking-wider bg-emerald-50 px-2.5 py-1 rounded-md border border-emerald-200">
                    {service.data.badge}
                  </span>
                </div>
                <h4 class="text-lg font-black text-gray-900 mb-2 group-hover:text-primary transition-colors tracking-tight">
                  {service.data.title}
                </h4>
                <p class="text-xs text-gray-600 line-clamp-2 font-normal leading-relaxed">
                  {service.data.description}
                </p>
              </div>
              <div class="pt-4 border-t border-gray-100 mt-4 flex items-center justify-between text-xs font-black text-secondary group-hover:text-primary transition-colors">
                <span>Ver detalhes</span>
                <span class="group-hover:translate-x-1.5 transition-transform">→</span>
              </div>
            </a>
          ))}
        </div>
      </div>
    </section>
  </main>
</Layout>

