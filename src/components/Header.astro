---
import { SITE_CONFIG } from '../data/config';

const navLinks = [
  { name: 'Início', href: '/', icon: 'home' },
  { name: 'Serviços', href: '/servicos', icon: 'services' },
  { name: 'Sobre Nós', href: '/sobre', icon: 'about' },
  { name: 'Contato', href: '/contato', icon: 'contact' },
];

const whatsappUrl = SITE_CONFIG.whatsappUrl;
---

<header class="sticky top-0 z-50 bg-white border-b border-gray-100 shadow-sm transition-all duration-300">
  <div class="container mx-auto px-6 lg:px-12">
    <div class="flex items-center justify-between h-20 sm:h-24">
      <!-- Logo & Branding -->
      <a
        href="/"
        class="flex items-center gap-3 group focus:outline-none focus:ring-2 focus:ring-primary rounded-xl transition-all duration-300 hover:scale-105 active:scale-95"
      >
        <div class="w-10 h-10 sm:w-12 sm:h-12 rounded-xl bg-secondary flex items-center justify-center text-white font-black text-lg shadow-md shadow-secondary/20 group-hover:scale-105 transition-all duration-300">
          AG
        </div>
        <div class="flex flex-col">
          <span class="text-xl sm:text-2xl font-black text-gray-900 tracking-tight leading-none">
            Vidraçaria <span class="text-primary">Axis Glass</span>
          </span>
          <span class="text-xs uppercase tracking-wider font-semibold text-gray-600 mt-1">
            {SITE_CONFIG.address.addressLocality} - {SITE_CONFIG.address.addressRegion}
          </span>
        </div>
      </a>

      <!-- Desktop Navigation -->
      <nav class="hidden md:flex items-center gap-8 text-sm font-bold text-gray-900">
        <a href="/" class="hover:text-primary py-2 relative transition-all duration-300 hover:scale-105 active:scale-95">Início</a>
        <a href="/servicos" class="hover:text-primary py-2 relative transition-all duration-300 hover:scale-105 active:scale-95">Serviços</a>
        <a href="/sobre" class="hover:text-primary py-2 relative transition-all duration-300 hover:scale-105 active:scale-95">Sobre Nós</a>
        <a href="/contato" class="hover:text-primary py-2 relative transition-all duration-300 hover:scale-105 active:scale-95">Contato</a>
      </nav>

      <!-- Desktop CTA WhatsApp & Mobile Hamburger -->
      <div class="flex items-center gap-3 sm:gap-4">
        <a
          href={whatsappUrl}
          target="_blank"
          rel="noopener noreferrer"
          class="inline-flex items-center gap-2 px-5 py-3 sm:px-6 sm:py-3.5 rounded-xl bg-[#25D366] hover:bg-emerald-600 text-white font-black text-xs sm:text-sm shadow-md shadow-green-600/25 transition-all duration-300 hover:scale-105 active:scale-95 focus:outline-none focus:ring-2 focus:ring-green-400 focus:ring-offset-2"
        >
          <svg class="w-4 h-4 fill-current shrink-0" viewBox="0 0 24 24">
            <path d="M.057 24l1.687-6.163c-1.041-1.804-1.588-3.849-1.587-5.946.003-6.556 5.338-11.891 11.893-11.891 3.181.001 6.167 1.24 8.413 3.488 2.245 2.248 3.481 5.236 3.48 8.414-.003 6.557-5.338 11.892-11.893 11.892-1.99-.001-3.951-.5-5.688-1.448l-6.305 1.654zm6.597-3.807c1.676.995 3.276 1.591 5.392 1.592 5.448 0 9.886-4.434 9.889-9.885.002-5.462-4.415-9.89-9.881-9.892-5.452 0-9.887 4.434-9.889 9.884-.001 2.225.651 3.891 1.746 5.634l-.999 3.648 3.742-.981zm11.387-5.464c-.074-.124-.272-.198-.57-.347-.297-.149-1.758-.868-2.031-.967-.272-.099-.47-.149-.669.149-.198.297-.768.967-.941 1.165-.173.198-.347.223-.644.074-.297-.149-1.255-.462-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.297-.347.446-.521.151-.172.2-.296.3-.495.099-.198.05-.372-.025-.521-.075-.148-.669-1.611-.916-2.206-.242-.579-.487-.501-.669-.51l-.57-.01c-.198 0-.52.074-.792.372s-1.04 1.016-1.04 2.479 1.065 2.876 1.213 3.074c.149.198 2.095 3.2 5.076 4.487.709.306 1.263.489 1.694.626.712.226 1.36.194 1.872.118.571-.085 1.758-.719 2.006-1.413.248-.695.248-1.29.173-1.414z"/>
          </svg>
          <span class="hidden sm:inline">Orçamento WhatsApp</span>
          <span class="sm:hidden">WhatsApp</span>
        </a>

        <!-- Botão Abrir Menu Mobile -->
        <button
          id="mobile-open-btn"
          aria-label="Abrir Menu de Navegação"
          class="md:hidden p-3 rounded-2xl bg-gray-100 text-gray-900 hover:bg-secondary hover:text-white transition-all duration-300 hover:scale-105 active:scale-95 focus:outline-none focus:ring-2 focus:ring-secondary"
        >
          <svg class="w-6 h-6" fill="none" viewBox="0 0 24 24" stroke="currentColor">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M4 6h16M4 12h16M4 18h16" />
          </svg>
        </button>
      </div>
    </div>
  </div>

  <!-- Drawer Mobile 100% Sólido, Limpo e Fácil de Entender -->
  <div
    id="mobile-drawer"
    class="fixed inset-0 z-[999999] hidden flex-col w-full h-full min-h-screen transition-all duration-200 overflow-y-auto"
    style="background-color: #064E3B !important;"
    role="dialog"
    aria-modal="true"
    aria-label="Menu Principal"
  >
    <!-- Topo do Drawer: Logo & Botão 'X' Fechar -->
    <div class="px-6 py-5 border-b border-white/10 flex items-center justify-between shrink-0 bg-[#043d2f]">
      <div class="flex items-center gap-3">
        <div class="w-10 h-10 rounded-xl bg-white text-[#064E3B] flex items-center justify-center font-black text-base shadow-md">
          AG
        </div>
        <div class="flex flex-col text-left">
          <span class="text-base font-black text-white tracking-tight leading-none">
            Vidraçaria <span class="text-emerald-300">Axis Glass</span>
          </span>
          <span class="text-[11px] uppercase tracking-wider text-emerald-200 font-semibold mt-1">
            Uberlândia - MG
          </span>
        </div>
      </div>

      <!-- Botão Fechar 'X' com Alto Contraste -->
      <button
        id="mobile-close-btn"
        aria-label="Fechar Menu"
        class="w-10 h-10 rounded-xl bg-white/15 hover:bg-white text-white hover:text-[#064E3B] flex items-center justify-center transition-all duration-200 active:scale-95 focus:outline-none"
      >
        <svg class="w-5 h-5" fill="none" viewBox="0 0 24 24" stroke="currentColor">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M6 18L18 6M6 6l12 12" />
        </svg>
      </button>
    </div>

    <!-- Navegação Simples, Direta e Sem Poluição Visual -->
    <nav class="flex-1 px-6 py-8 flex flex-col justify-center space-y-3">
      {navLinks.map((link) => (
        <a
          href={link.href}
          class="mobile-nav-link flex items-center justify-between py-4 px-5 rounded-2xl bg-white/10 hover:bg-white/20 active:bg-emerald-600 text-white font-bold text-lg transition-all"
        >
          <div class="flex items-center gap-4">
            {link.icon === 'home' && (
              <svg class="w-6 h-6 text-emerald-300 shrink-0" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 12l2-2m0 0l7-7 7 7M5 10v10a1 1 0 001 1h3m10-11l2 2m-2-2v10a1 1 0 01-1 1h-3m-6 0a1 1 0 001-1v-4a1 1 0 011-1h2a1 1 0 011 1v4a1 1 0 001 1m-6 0h6" />
              </svg>
            )}
            {link.icon === 'services' && (
              <svg class="w-6 h-6 text-emerald-300 shrink-0" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 6a2 2 0 012-2h2a2 2 0 012 2v2a2 2 0 01-2 2H6a2 2 0 01-2-2V6zM14 6a2 2 0 012-2h2a2 2 0 012 2v2a2 2 0 01-2 2h-2a2 2 0 01-2-2V6zM4 16a2 2 0 012-2h2a2 2 0 012 2v2a2 2 0 01-2 2H6a2 2 0 01-2-2v-2zM14 16a2 2 0 012-2h2a2 2 0 012 2v2a2 2 0 01-2 2h-2a2 2 0 01-2-2v-2z" />
              </svg>
            )}
            {link.icon === 'about' && (
              <svg class="w-6 h-6 text-emerald-300 shrink-0" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12l2 2 4-4m5.618-4.016A11.955 11.955 0 0112 2.944a11.955 11.955 0 01-8.618 3.04A12.02 12.02 0 003 9c0 5.591 3.824 10.29 9 11.622 5.176-1.332 9-6.03 9-11.622 0-1.042-.133-2.052-.382-3.016z" />
              </svg>
            )}
            {link.icon === 'contact' && (
              <svg class="w-6 h-6 text-emerald-300 shrink-0" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 5a2 2 0 012-2h3.28a1 1 0 01.948.684l1.498 4.493a1 1 0 01-.502 1.21l-2.257 1.13a11.042 11.042 0 005.516 5.516l1.13-2.257a1 1 0 011.21-.502l4.493 1.498a1 1 0 01.684.949V19a2 2 0 01-2 2h-1C9.716 21 3 14.284 3 6V5z" />
              </svg>
            )}
            <span>{link.name}</span>
          </div>
          <span class="text-emerald-300 text-lg font-bold">→</span>
        </a>
      ))}
    </nav>

    <!-- Rodapé: WhatsApp e Informações -->
    <div class="px-6 py-5 border-t border-white/10 space-y-3 shrink-0 bg-[#043d2f]">
      <a
        href={whatsappUrl}
        target="_blank"
        rel="noopener noreferrer"
        class="w-full inline-flex items-center justify-center gap-3 py-4 px-5 rounded-2xl bg-[#25D366] hover:bg-emerald-500 text-white font-bold text-base shadow-lg transition-all duration-200 active:scale-95 text-center"
      >
        <svg class="w-5 h-5 fill-current shrink-0" viewBox="0 0 24 24">
          <path d="M.057 24l1.687-6.163c-1.041-1.804-1.588-3.849-1.587-5.946.003-6.556 5.338-11.891 11.893-11.891 3.181.001 6.167 1.24 8.413 3.488 2.245 2.248 3.481 5.236 3.48 8.414-.003 6.557-5.338 11.892-11.893 11.892-1.99-.001-3.951-.5-5.688-1.448l-6.305 1.654zm6.597-3.807c1.676.995 3.276 1.591 5.392 1.592 5.448 0 9.886-4.434 9.889-9.885.002-5.462-4.415-9.89-9.881-9.892-5.452 0-9.887 4.434-9.889 9.884-.001 2.225.651 3.891 1.746 5.634l-.999 3.648 3.742-.981zm11.387-5.464c-.074-.124-.272-.198-.57-.347-.297-.149-1.758-.868-2.031-.967-.272-.099-.47-.149-.669.149-.198.297-.768.967-.941 1.165-.173.198-.347.223-.644.074-.297-.149-1.255-.462-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.297-.347.446-.521.151-.172.2-.296.3-.495.099-.198.05-.372-.025-.521-.075-.148-.669-1.611-.916-2.206-.242-.579-.487-.501-.669-.51l-.57-.01c-.198 0-.52.074-.792.372s-1.04 1.016-1.04 2.479 1.065 2.876 1.213 3.074c.149.198 2.095 3.2 5.076 4.487.709.306 1.263.489 1.694.626.712.226 1.36.194 1.872.118.571-.085 1.758-.719 2.006-1.413.248-.695.248-1.29.173-1.414z"/>
        </svg>
        <span>Solicitar Orçamento no WhatsApp</span>
      </a>

      <div class="text-xs text-emerald-200/90 text-center font-medium">
        📍 {SITE_CONFIG.address.streetAddress} • Uberlândia - MG
      </div>
    </div>
  </div>
</header>

<script>
  const openBtn = document.getElementById('mobile-open-btn');
  const closeBtn = document.getElementById('mobile-close-btn');
  const drawer = document.getElementById('mobile-drawer');
  const navLinks = document.querySelectorAll('.mobile-nav-link');

  function openMenu() {
    if (!drawer) return;
    drawer.classList.remove('hidden');
    drawer.classList.add('flex');
    document.body.style.overflow = 'hidden';
    const floatingBtn = document.getElementById('floating-whatsapp');
    if (floatingBtn) floatingBtn.style.display = 'none';
  }

  function closeMenu() {
    if (!drawer) return;
    drawer.classList.add('hidden');
    drawer.classList.remove('flex');
    document.body.style.overflow = '';
    const floatingBtn = document.getElementById('floating-whatsapp');
    if (floatingBtn) floatingBtn.style.display = '';
  }

  if (openBtn) openBtn.addEventListener('click', openMenu);
  if (closeBtn) closeBtn.addEventListener('click', closeMenu);

  navLinks.forEach((link) => {
    link.addEventListener('click', closeMenu);
  });

  window.addEventListener('keydown', (e) => {
    if (e.key === 'Escape') closeMenu();
  });
</script>