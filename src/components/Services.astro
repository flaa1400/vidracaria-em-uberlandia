---
import { getCollection } from 'astro:content';
import { SITE_CONFIG } from '../data/config';
import ServiceIcon from './ServiceIcon.astro';

const services = await getCollection('servicos');
services.sort((a, b) => a.data.order - b.data.order);
const featuredServices = services.slice(0, 6);
const whatsappUrl = SITE_CONFIG.whatsappUrl;
---

<section id="servicos" class="py-24 lg:py-32 bg-gradient-to-b from-gray-50/90 via-emerald-50/30 to-gray-50/90 border-b border-emerald-100/80 relative">
  <div class="container mx-auto px-6 lg:px-12">
    <!-- Section Header -->
    <div class="max-w-3xl mx-auto text-center mb-16 lg:mb-20">
      <span class="inline-block py-1.5 px-4 rounded-full bg-emerald-100 text-secondary text-xs font-black uppercase tracking-wider mb-4 border border-emerald-200 shadow-xs">
        Nossas Soluções em Uberlândia
      </span>
      <h2 class="text-3xl sm:text-4xl lg:text-5xl font-black text-gray-900 leading-tight tracking-tighter mb-6">
        Vidraçaria esquadrias e serviços especializados em Uberlândia
      </h2>
      <p class="text-base sm:text-lg text-gray-600 leading-relaxed font-normal">
        Fabricação, instalação e assistência técnica com foco em vidros e esquadrias de alto padrão. Atuamos como uma Vidraçaria em Uberlândia de referência com vidros certificados pelo Inmetro e atendimento pontual.
      </p>
    </div>

    <!-- Cards Grid: Verde e Branco -->
    <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-8 lg:gap-10">
      {featuredServices.map((service) => (
        <div class="bg-white rounded-3xl p-8 lg:p-10 border-2 border-emerald-100/90 shadow-[0_10px_30px_-5px_rgba(6,78,59,0.07)] hover:shadow-[0_20px_45px_-5px_rgba(6,78,59,0.16)] hover:border-emerald-500/70 transition-all duration-300 hover:-translate-y-1.5 flex flex-col justify-between group relative overflow-hidden">
          <!-- Barra de Destaque Superior do Card -->
          <div class="absolute top-0 left-0 right-0 h-1.5 bg-gradient-to-r from-emerald-600 via-primary to-emerald-400 group-hover:h-2 transition-all"></div>

          <div>
            <!-- Topo do Card com Ícone e Badge -->
            <div class="flex items-center justify-between gap-4 mb-6 pt-1">
              <div class="w-14 h-14 rounded-2xl bg-emerald-50 text-secondary border border-emerald-200/80 flex items-center justify-center shadow-sm group-hover:scale-110 group-hover:bg-[#064E3B] group-hover:text-emerald-300 transition-all duration-300 shrink-0">
                <ServiceIcon slug={service.slug} class="w-7 h-7" />
              </div>

              <span class="inline-block py-1.5 px-3 rounded-xl bg-emerald-50 text-secondary border border-emerald-200/90 text-xs font-black uppercase tracking-wider shadow-xs">
                {service.data.badge}
              </span>
            </div>

            <!-- Título do Serviço -->
            <h3 class="text-xl sm:text-2xl font-black text-gray-900 leading-tight mb-4 group-hover:text-primary transition-colors tracking-tight">
              <a href={`/servicos/${service.slug}`}>
                {service.data.title}
              </a>
            </h3>

            <!-- Descrição -->
            <p class="text-gray-600 text-sm sm:text-base leading-relaxed mb-6 font-normal">
              {service.data.description}
            </p>

            <!-- Checklist Organizado em Blocos -->
            {service.data.features && service.data.features.length > 0 && (
              <ul class="space-y-2.5 mb-6">
                {service.data.features.slice(0, 3).map((feature) => (
                  <li class="flex items-start gap-2.5 p-2.5 rounded-xl bg-emerald-50/50 border border-emerald-100/80 text-xs sm:text-sm text-gray-800 font-medium group-hover:bg-emerald-50/80 transition-colors">
                    <span class="w-5 h-5 rounded-lg bg-emerald-200/80 text-secondary flex items-center justify-center shrink-0 mt-0.5 text-xs font-black">✓</span>
                    <span class="leading-snug">{feature}</span>
                  </li>
                ))}
              </ul>
            )}
          </div>

          <div class="pt-5 border-t border-gray-100 flex flex-col gap-3">
            <a
              href={`/servicos/${service.slug}`}
              class="inline-flex items-center justify-between font-bold text-xs sm:text-sm text-secondary hover:text-primary transition-colors"
            >
              <span>Ver Detalhes do Serviço</span>
              <span class="group-hover:translate-x-1.5 transition-transform">→</span>
            </a>
            <a
              href={whatsappUrl}
              target="_blank"
              rel="noopener noreferrer"
              class="inline-flex items-center justify-center gap-2 w-full p-3.5 rounded-xl bg-green-50 hover:bg-[#25D366] text-secondary hover:text-white text-xs font-black transition-all duration-300 hover:scale-105 active:scale-95 border border-green-200/80 hover:border-[#25D366]"
            >
              <span>Pedir Orçamento no WhatsApp</span>
            </a>
          </div>
        </div>
      ))}
    </div>

    <!-- Botão Ver Todos os 15 Serviços -->
    <div class="mt-16 text-center">
      <a
        href="/servicos"
        class="inline-flex items-center gap-3 px-10 py-5 rounded-2xl bg-secondary hover:bg-emerald-950 text-white font-black text-base shadow-xl shadow-secondary/20 transition-all duration-300 hover:scale-105 active:scale-95"
      >
        <span>Ver Todos os 15 Serviços em Uberlândia</span>
        <span>→</span>
      </a>
    </div>
  </div>
</section>
