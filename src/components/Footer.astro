---
import { SITE_CONFIG } from '../data/config';

import { SERVICES_LIST } from '../data/servicesData';

const currentYear = new Date().getFullYear();

const serviceLinks = SERVICES_LIST.map((service) => ({
  name: service.title,
  href: `/servicos/${service.slug}`,
}));

const quickLinks = [
  { name: "Início", href: "/" },
  { name: "Todos os Serviços", href: "/servicos" },
  { name: "Bairros Atendidos", href: "/bairros" },
  { name: "Sobre a Empresa", href: "/sobre" },
  { name: "Fale Conosco", href: "/contato" },
];

const whatsappUrl = SITE_CONFIG.whatsappUrl;
const instagramUrl = SITE_CONFIG.social.instagram;
const facebookUrl = SITE_CONFIG.social.facebook;
---

<footer class="bg-[#064E3B] text-white pt-24 pb-16 border-t border-emerald-950 relative">
  <div class="container mx-auto px-6 lg:px-12">
    <!-- Top Call to Action in Footer: Fundo Verde Floresta com WhatsApp -->
    <div class="bg-[#043d2f] border border-emerald-500/30 rounded-3xl p-8 sm:p-10 lg:p-12 mb-20 text-center relative overflow-hidden shadow-2xl">
      <div class="max-w-2xl mx-auto relative z-10">
        <h3 class="text-2xl sm:text-3xl lg:text-4xl font-black text-white leading-tight mb-4 tracking-tighter">
          Pronto para Transformar seu Projeto em <span class="text-emerald-300">Uberlândia</span>?
        </h3>
        <p class="text-emerald-100 text-base mb-8 font-normal">
          Envie suas medidas aproximadas pelo WhatsApp ou agende uma visita técnica sem compromisso em qualquer bairro da cidade.
        </p>
        <!-- Botão WhatsApp Grande Único -->
        <div class="flex justify-center">
          <a
            href={whatsappUrl}
            target="_blank"
            rel="noopener noreferrer"
            class="w-full sm:w-auto inline-flex items-center justify-center gap-3 px-10 py-5 rounded-2xl bg-[#25D366] hover:bg-emerald-500 text-white font-black text-base sm:text-lg shadow-xl shadow-black/30 transition-all duration-300 hover:scale-105 active:scale-95"
          >
            <svg class="w-6 h-6 fill-current shrink-0" viewBox="0 0 24 24">
              <path d="M.057 24l1.687-6.163c-1.041-1.804-1.588-3.849-1.587-5.946.003-6.556 5.338-11.891 11.893-11.891 3.181.001 6.167 1.24 8.413 3.488 2.245 2.248 3.481 5.236 3.48 8.414-.003 6.557-5.338 11.892-11.893 11.892-1.99-.001-3.951-.5-5.688-1.448l-6.305 1.654zm6.597-3.807c1.676.995 3.276 1.591 5.392 1.592 5.448 0 9.886-4.434 9.889-9.885.002-5.462-4.415-9.89-9.881-9.892-5.452 0-9.887 4.434-9.889 9.884-.001 2.225.651 3.891 1.746 5.634l-.999 3.648 3.742-.981zm11.387-5.464c-.074-.124-.272-.198-.57-.347-.297-.149-1.758-.868-2.031-.967-.272-.099-.47-.149-.669.149-.198.297-.768.967-.941 1.165-.173.198-.347.223-.644.074-.297-.149-1.255-.462-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.297-.347.446-.521.151-.172.2-.296.3-.495.099-.198.05-.372-.025-.521-.075-.148-.669-1.611-.916-2.206-.242-.579-.487-.501-.669-.51l-.57-.01c-.198 0-.52.074-.792.372s-1.04 1.016-1.04 2.479 1.065 2.876 1.213 3.074c.149.198 2.095 3.2 5.076 4.487.709.306 1.263.489 1.694.626.712.226 1.36.194 1.872.118.571-.085 1.758-.719 2.006-1.413.248-.695.248-1.29.173-1.414z"/>
            </svg>
            <span>Falar no WhatsApp</span>
          </a>
        </div>
      </div>
    </div>

    <!-- Main Footer Grid -->
    <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-12 gap-10 lg:gap-12 pb-16 border-b border-white/10">
      <!-- Col 1: About & Brand (3 colunas em lg) -->
      <div class="lg:col-span-3">
        <a href="/" class="flex items-center gap-3 mb-6 group inline-flex transition-transform hover:scale-105">
          <div class="w-10 h-10 rounded-xl bg-white text-secondary flex items-center justify-center font-black shadow-md">
            AG
          </div>
          <span class="text-xl font-black text-white tracking-tight">
            {SITE_CONFIG.name}
          </span>
        </a>
        <p class="text-sm text-green-100 leading-relaxed mb-6 max-w-sm font-normal">
          {SITE_CONFIG.description}
        </p>

        <!-- Redes Sociais no Rodapé -->
        <div class="flex items-center gap-3 mb-6">
          <a
            href={instagramUrl}
            target="_blank"
            rel="noopener noreferrer"
            aria-label="Instagram da Vidraçaria Axis Glass"
            class="w-10 h-10 rounded-xl bg-white/10 hover:bg-white text-white hover:text-secondary flex items-center justify-center transition-all duration-300 hover:scale-110"
          >
            <svg class="w-5 h-5 fill-current" viewBox="0 0 24 24">
              <path d="M12 2.163c3.204 0 3.584.012 4.85.07 3.252.148 4.771 1.691 4.919 4.919.058 1.265.069 1.645.069 4.849 0 3.205-.012 3.584-.069 4.849-.149 3.225-1.664 4.771-4.919 4.919-1.266.058-1.644.07-4.85.07-3.204 0-3.584-.012-4.849-.07-3.26-.149-4.771-1.699-4.919-4.92-.058-1.265-.07-1.644-.07-4.849 0-3.204.013-3.583.07-4.849.149-3.227 1.664-4.771 4.919-4.919 1.266-.057 1.645-.069 4.849-.069zm0-2.163c-3.259 0-3.667.014-4.947.072-4.358.2-6.78 2.618-6.98 6.98-.059 1.281-.073 1.689-.073 4.948 0 3.259.014 3.668.072 4.948.2 4.358 2.618 6.78 6.98 6.98 1.281.058 1.689.072 4.948.072 3.259 0 3.668-.014 4.948-.072 4.354-.2 6.782-2.618 6.979-6.98.059-1.28.073-1.689.073-4.948 0-3.259-.014-3.667-.072-4.947-.196-4.354-2.617-6.78-6.979-6.98-1.281-.059-1.69-.073-4.949-.073zm0 5.838c-3.403 0-6.162 2.759-6.162 6.162s2.759 6.163 6.162 6.163 6.162-2.759 6.162-6.163c0-3.403-2.759-6.162-6.162-6.162zm0 10.162c-2.209 0-4-1.79-4-4 0-2.209 1.791-4 4-4s4 1.791 4 4c0 2.21-1.791 4-4 4zm6.406-11.845c-.796 0-1.441.645-1.441 1.44s.645 1.44 1.441 1.44c.795 0 1.439-.645 1.439-1.44s-.644-1.44-1.439-1.44z"/>
            </svg>
          </a>

          <a
            href={facebookUrl}
            target="_blank"
            rel="noopener noreferrer"
            aria-label="Facebook da Vidraçaria Axis Glass"
            class="w-10 h-10 rounded-xl bg-white/10 hover:bg-white text-white hover:text-secondary flex items-center justify-center transition-all duration-300 hover:scale-110"
          >
            <svg class="w-5 h-5 fill-current" viewBox="0 0 24 24">
              <path d="M24 12.073c0-6.627-5.373-12-12-12s-12 5.373-12 12c0 5.99 4.388 10.954 10.125 11.854v-8.385H7.078v-3.47h3.047V9.43c0-3.007 1.792-4.669 4.533-4.669 1.312 0 2.686.235 2.686.235v2.953H15.83c-1.491 0-1.956.925-1.956 1.874v2.25h3.328l-.532 3.47h-2.796v8.385C19.612 23.027 24 18.062 24 12.073z"/>
            </svg>
          </a>
        </div>

        <div class="text-xs text-green-200 space-y-1 font-medium">
          <p>Atendimento: {SITE_CONFIG.openingHoursHuman}</p>
        </div>
      </div>

      <!-- Col 2: Navegação Rápida (2 colunas em lg) -->
      <div class="lg:col-span-2">
        <h4 class="text-sm font-black text-green-300 uppercase tracking-wider mb-6">
          Institucional
        </h4>
        <ul class="space-y-3 text-sm text-green-100">
          {quickLinks.map((link) => (
            <li>
              <a
                href={link.href}
                class="hover:text-white transition-all duration-300 hover:scale-105 inline-block"
              >
                {link.name}
              </a>
            </li>
          ))}
        </ul>
      </div>

      <!-- Col 3: Todos os Serviços (4 colunas em lg com 2 subcolunas) -->
      <div class="lg:col-span-4">
        <h4 class="text-sm font-black text-green-300 uppercase tracking-wider mb-6">
          Todos os Serviços
        </h4>
        <ul class="grid grid-cols-1 sm:grid-cols-2 gap-x-4 gap-y-2.5 text-xs text-green-100 font-medium">
          {serviceLinks.map((service) => (
            <li>
              <a
                href={service.href}
                class="hover:text-white transition-all duration-300 hover:translate-x-1 inline-block"
              >
                {service.name}
              </a>
            </li>
          ))}
        </ul>
      </div>

      <!-- Col 4: Contato & Bairros (3 colunas em lg) -->
      <div class="lg:col-span-3">
        <h4 class="text-sm font-black text-green-300 uppercase tracking-wider mb-6">
          Localização
        </h4>
        <ul class="space-y-3 text-sm text-green-100 mb-6 font-medium">
          <li>{SITE_CONFIG.address.fullFormatted}</li>
          <li>
            <a href={whatsappUrl} target="_blank" rel="noopener noreferrer" class="hover:text-white transition-colors">
              WhatsApp: {SITE_CONFIG.whatsapp}
            </a>
          </li>
          <li>{SITE_CONFIG.email}</li>
        </ul>
      </div>
    </div>

    <!-- Copyright Bar & Links Legais com Contraste Total -->
    <div class="pt-8 flex flex-col sm:flex-row items-center justify-between text-xs text-green-200 gap-4">
      <p>© {currentYear} {SITE_CONFIG.name}. Todos os direitos reservados.</p>
      <div class="flex items-center gap-6">
        <a href="/privacidade" class="text-green-100 hover:text-white transition-colors">Política de Privacidade</a>
        <a href="/termos" class="text-green-100 hover:text-white transition-colors">Termos de Uso</a>
      </div>
    </div>
  </div>
</footer>
