---
import { SITE_CONFIG } from '../data/config';

const whatsappUrl = SITE_CONFIG.whatsappUrl;
---

<section class="relative bg-gradient-to-b from-[#064E3B] via-[#043d2f] to-[#02281e] overflow-hidden py-14 sm:py-16 lg:py-20 border-b border-emerald-950 text-white">
  <!-- Efeitos Elegantes de Fundo em Verde e Iluminação Suave -->
  <div class="absolute inset-0 pointer-events-none overflow-hidden">
    <div class="absolute -top-32 -right-32 w-[500px] h-[500px] rounded-full bg-emerald-500/20 blur-3xl"></div>
    <div class="absolute -bottom-32 -left-32 w-[500px] h-[500px] rounded-full bg-green-400/15 blur-3xl"></div>
    <div class="absolute inset-0 bg-[radial-gradient(#ffffff0d_1px,transparent_1px)] [background-size:24px_24px]"></div>
  </div>

  <div class="container mx-auto px-6 lg:px-12 relative z-10">
    <div class="max-w-4xl mx-auto text-center">
      <!-- Tag / Badge Local com Alto Contraste -->
      <div class="inline-flex items-center gap-2.5 px-4 py-2 sm:px-5 sm:py-2.5 rounded-full bg-white/10 border border-white/20 backdrop-blur-md shadow-lg mb-6 transition-all duration-300 hover:scale-105">
        <span class="w-2.5 h-2.5 rounded-full bg-emerald-400 animate-pulse"></span>
        <span class="text-xs sm:text-sm font-black text-emerald-200 uppercase tracking-wider">
          A Sua Vidraçaria em Uberlândia • Atendimento em toda a Região
        </span>
      </div>

      <!-- H1 com Palavra-chave Principal: 100% Legível em Fundo Verde -->
      <h1 class="text-3xl sm:text-4xl md:text-5xl lg:text-6xl font-black text-white tracking-tighter leading-tight drop-shadow-sm">
        Vidraçaria em Uberlândia: <span class="text-emerald-300">Vidros Temperados</span>, Esquadrias e Manutenções
      </h1>

      <!-- Subtítulo em Alto Contraste (text-emerald-100) -->
      <p class="text-base sm:text-lg lg:text-xl text-emerald-100 leading-relaxed max-w-3xl mx-auto mt-5 font-medium">
        Para você que procura por Vidraçaria Uberlândia e precisa de uma vidraçaria de confiança perto de você, a Axis Glass oferece o atendimento ágil do vidraceiro mais próximo em todos os bairros. Somos especialistas em vidros e esquadrias de alto padrão, box de banheiro até o teto, cortinas de vidro para sacadas, espelhos e manutenções com medição a laser sem taxa de visita.
      </p>

      <!-- Botão Único de Conversão: WhatsApp em Destaque Absoluto -->
      <div class="mt-8 sm:mt-9 flex flex-col items-center justify-center">
        <a
          href={whatsappUrl}
          target="_blank"
          rel="noopener noreferrer"
          class="w-full sm:w-auto inline-flex items-center justify-center gap-3 px-8 py-4 sm:px-9 sm:py-4.5 rounded-2xl bg-[#25D366] hover:bg-emerald-500 text-white font-black text-base sm:text-lg shadow-2xl shadow-black/40 transition-all duration-300 hover:scale-105 active:scale-95 border border-emerald-300/30"
        >
          <svg class="w-6 h-6 fill-current shrink-0" viewBox="0 0 24 24">
            <path d="M.057 24l1.687-6.163c-1.041-1.804-1.588-3.849-1.587-5.946.003-6.556 5.338-11.891 11.893-11.891 3.181.001 6.167 1.24 8.413 3.488 2.245 2.248 3.481 5.236 3.48 8.414-.003 6.557-5.338 11.892-11.893 11.892-1.99-.001-3.951-.5-5.688-1.448l-6.305 1.654zm6.597-3.807c1.676.995 3.276 1.591 5.392 1.592 5.448 0 9.886-4.434 9.889-9.885.002-5.462-4.415-9.89-9.881-9.892-5.452 0-9.887 4.434-9.889 9.884-.001 2.225.651 3.891 1.746 5.634l-.999 3.648 3.742-.981zm11.387-5.464c-.074-.124-.272-.198-.57-.347-.297-.149-1.758-.868-2.031-.967-.272-.099-.47-.149-.669.149-.198.297-.768.967-.941 1.165-.173.198-.347.223-.644.074-.297-.149-1.255-.462-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.297-.347.446-.521.151-.172.2-.296.3-.495.099-.198.05-.372-.025-.521-.075-.148-.669-1.611-.916-2.206-.242-.579-.487-.501-.669-.51l-.57-.01c-.198 0-.52.074-.792.372s-1.04 1.016-1.04 2.479 1.065 2.876 1.213 3.074c.149.198 2.095 3.2 5.076 4.487.709.306 1.263.489 1.694.626.712.226 1.36.194 1.872.118.571-.085 1.758-.719 2.006-1.413.248-.695.248-1.29.173-1.414z"/>
          </svg>
          <span>Solicitar Orçamento no WhatsApp</span>
        </a>
      </div>
    </div>
  </div>
</section>
