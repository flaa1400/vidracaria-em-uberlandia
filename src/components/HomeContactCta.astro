---
import { SITE_CONFIG } from '../data/config';

const whatsappUrl = `https://wa.me/${SITE_CONFIG.whatsappRaw}?text=${encodeURIComponent(SITE_CONFIG.whatsappDefaultMessage)}`;
---

<section class="bg-gray-50 py-24 lg:py-32">
  <div class="container mx-auto px-6 lg:px-12">
    <!-- DITADURA DO CONTRASTE: Fundo escuro com texto de corpo text-white/text-gray-100 e títulos text-primary/text-white -->
    <div class="bg-gradient-to-br from-secondary via-blue-950 to-slate-950 rounded-3xl p-10 lg:p-14 text-white text-center max-w-5xl mx-auto shadow-2xl shadow-secondary/30 relative overflow-hidden">
      <!-- Decorative background glow -->
      <div class="absolute -top-24 -left-24 w-72 h-72 bg-yellow-400/10 rounded-full blur-3xl pointer-events-none"></div>
      <div class="absolute -bottom-24 -right-24 w-72 h-72 bg-blue-500/20 rounded-full blur-3xl pointer-events-none"></div>

      <div class="relative z-10 max-w-3xl mx-auto">
        <span class="inline-block py-1.5 px-4 rounded-full bg-yellow-400/20 text-primary text-xs font-black uppercase tracking-wider mb-6 border border-yellow-400/30">
          Atendimento Direto & Ágil
        </span>

        <h2 class="text-3xl sm:text-4xl lg:text-5xl font-black text-white leading-tight tracking-tighter mb-6">
          Pronto para Tirar seu Projeto do Papel em <span class="text-primary">Uberlândia</span>?
        </h2>

        <!-- DITADURA DO CONTRASTE: text-gray-100 -->
        <p class="text-gray-100 text-base sm:text-xl leading-relaxed mb-10 font-normal">
          Envie uma mensagem pelo WhatsApp ou ligue para nossa equipe. Agendamos a medição a laser no seu imóvel sem nenhum custo e com horário marcado.
        </p>

        <!-- Botão WhatsApp com Micro-Interações hover:scale-105 active:scale-95 -->
        <div class="flex flex-col sm:flex-row items-center justify-center gap-5">
          <a
            href={SITE_CONFIG.whatsappUrl}
            target="_blank"
            rel="noopener noreferrer"
            class="w-full sm:w-auto inline-flex items-center justify-center gap-3 p-6 sm:px-10 sm:py-6 rounded-2xl bg-primary hover:bg-emerald-700 text-white font-black text-base sm:text-lg shadow-xl shadow-primary/30 transition-all duration-300 hover:scale-105 active:scale-95"
          >
            <svg class="w-6 h-6 fill-current shrink-0" viewBox="0 0 24 24">
              <path d="M.057 24l1.687-6.163c-1.041-1.804-1.588-3.849-1.587-5.946.003-6.556 5.338-11.891 11.893-11.891 3.181.001 6.167 1.24 8.413 3.488 2.245 2.248 3.481 5.236 3.48 8.414-.003 6.557-5.338 11.892-11.893 11.892-1.99-.001-3.951-.5-5.688-1.448l-6.305 1.654zm6.597-3.807c1.676.995 3.276 1.591 5.392 1.592 5.448 0 9.886-4.434 9.889-9.885.002-5.462-4.415-9.89-9.881-9.892-5.452 0-9.887 4.434-9.889 9.884-.001 2.225.651 3.891 1.746 5.634l-.999 3.648 3.742-.981zm11.387-5.464c-.074-.124-.272-.198-.57-.347-.297-.149-1.758-.868-2.031-.967-.272-.099-.47-.149-.669.149-.198.297-.768.967-.941 1.165-.173.198-.347.223-.644.074-.297-.149-1.255-.462-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.297-.347.446-.521.151-.172.2-.296.3-.495.099-.198.05-.372-.025-.521-.075-.148-.669-1.611-.916-2.206-.242-.579-.487-.501-.669-.51l-.57-.01c-.198 0-.52.074-.792.372s-1.04 1.016-1.04 2.479 1.065 2.876 1.213 3.074c.149.198 2.095 3.2 5.076 4.487.709.306 1.263.489 1.694.626.712.226 1.36.194 1.872.118.571-.085 1.758-.719 2.006-1.413.248-.695.248-1.29.173-1.414z"/>
            </svg>
            <span>Conversar no WhatsApp</span>
          </a>
        </div>

        <p class="mt-8 text-xs text-gray-100 font-medium">
          📍 Atendimento em todos os bairros de Uberlândia • Segunda a Sexta: 08h às 18h | Sábado: 08h às 12h
        </p>
      </div>
    </div>
  </div>
</section>
