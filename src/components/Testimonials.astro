---
const testimonials = [
  {
    name: "Rodrigo Almeida",
    role: "Morador do Bairro Tubalina",
    neighborhood: "Tubalina, Uberlândia - MG",
    service: "Box até o Teto e Espelho Bisotado com LED",
    stars: 5,
    comment: "Contratei a Vidraçaria Axis Glass para instalar o box até o teto e os espelhos do meu apartamento aqui no Tubalina. Medição a laser muito rápida, entrega antes do prazo e vedação impecável. A equipe é super cuidadosa e educada!",
  },
  {
    name: "Patrícia Mendes",
    role: "Arquiteta e Urbanista",
    neighborhood: "Jardim Karaíba, Uberlândia - MG",
    service: "Cortina de Vidro e Guarda-Corpo em Inox",
    stars: 5,
    comment: "Especifico a Axis Glass em vários projetos de clientes em Uberlândia. O sistema de cortina de vidro tem roldanas em aço inox maciço que deslizam com facilidade incrível. Rigor técnico e acabamento de altíssimo nível.",
  },
  {
    name: "Marcelo Silveira",
    role: "Empresário",
    neighborhood: "Granja Marileusa, Uberlândia - MG",
    service: "Esquadrias de Alumínio e Fechamento de Sacada",
    stars: 5,
    comment: "Melhor vidraçaria de Uberlândia. Solicitei o orçamento no WhatsApp e tive resposta em minutos. Instalaram as portas da linha Gold e o fechamento da sacada com perfeição. Recomendo de olhos fechados!",
  },
];
---

<section id="depoimentos" class="bg-white py-24 lg:py-32 border-b border-gray-100">
  <div class="container mx-auto px-6 lg:px-12">
    <!-- Header -->
    <div class="max-w-3xl mx-auto text-center mb-16 lg:mb-20">
      <span class="inline-block py-1.5 px-4 rounded-full bg-green-100 text-secondary text-xs font-black uppercase tracking-wider mb-4 border border-green-200">
        Avaliações de Clientes em Uberlândia
      </span>
      <h2 class="text-3xl sm:text-4xl lg:text-5xl font-black text-gray-900 leading-tight tracking-tighter mb-6">
        O Que Nossos Clientes Dizem Sobre Nossos Serviços
      </h2>
      <p class="text-base sm:text-lg text-gray-600 leading-relaxed font-normal">
        Compromisso comprovado com a pontualidade, atendimento atencioso e acabamento de primeira linha.
      </p>
    </div>

    <!-- Testimonials Grid em Verde e Branco -->
    <div class="grid grid-cols-1 md:grid-cols-3 gap-8 lg:gap-10">
      {testimonials.map((item) => (
        <div class="bg-brand-light/50 rounded-3xl p-8 lg:p-10 border border-green-100 flex flex-col justify-between hover:border-primary/40 hover:shadow-xl transition-all duration-300 hover:scale-105 active:scale-95 group">
          <div>
            <!-- Star Rating + Google Badge -->
            <div class="flex items-center justify-between mb-6">
              <div class="flex items-center gap-1 text-yellow-400" aria-label="Avaliação 5 estrelas">
                {Array.from({ length: item.stars }).map(() => (
                  <svg class="w-5 h-5 fill-current" viewBox="0 0 20 20">
                    <path d="M9.049 2.927c.3-.921 1.603-.921 1.902 0l1.07 3.292a1 1 0 00.95.69h3.462c.969 0 1.371 1.24.588 1.81l-2.8 2.034a1 1 0 00-.364 1.118l1.07 3.292c.3.921-.755 1.688-1.54 1.118l-2.8-2.034a1 1 0 00-1.175 0l-2.8 2.034c-.784.57-1.838-.197-1.539-1.118l1.07-3.292a1 1 0 00-.364-1.118L2.98 8.72c-.783-.57-.38-1.81.588-1.81h3.461a1 1 0 00.951-.69l1.07-3.292z" />
                  </svg>
                ))}
                <span class="text-xs font-black text-gray-700 ml-1.5">5.0</span>
              </div>
              <span class="text-[11px] font-bold text-secondary bg-white px-2 py-0.5 rounded border border-green-200">
                Google Review
              </span>
            </div>

            <!-- Serviço contratado -->
            <span class="text-xs font-black uppercase tracking-wider text-primary block mb-3">
              {item.service}
            </span>

            <p class="text-gray-700 text-sm sm:text-base leading-relaxed mb-6 font-normal italic">
              "{item.comment}"
            </p>
          </div>

          <div class="pt-4 border-t border-green-100 flex items-center gap-3">
            <div class="w-10 h-10 rounded-full bg-secondary text-white font-black text-sm flex items-center justify-center shrink-0">
              {item.name.charAt(0)}
            </div>
            <div>
              <strong class="text-sm font-black text-gray-900 block leading-tight">{item.name}</strong>
              <span class="text-xs text-gray-500 font-medium">{item.neighborhood}</span>
            </div>
          </div>
        </div>
      ))}
    </div>
  </div>
</section>
