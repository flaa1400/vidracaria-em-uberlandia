---
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import SEO from '../components/SEO.astro';
import SchemaLocalBusiness from '../components/SchemaLocalBusiness.astro';
import WhatsAppBtn from '../components/WhatsAppBtn.astro';
import { SITE_CONFIG } from '../data/config';

interface Props {
  title?: string;
  description?: string;
  canonicalUrl?: string;
  ogImage?: string;
  ogType?: 'website' | 'article';
  noindex?: boolean;
}

const {
  title = `${SITE_CONFIG.name} | ${SITE_CONFIG.slogan}`,
  description = SITE_CONFIG.description,
  canonicalUrl,
  ogImage,
  ogType = 'website',
  noindex = false,
} = Astro.props;
---

<!doctype html>
<html lang="pt-BR" class="scroll-smooth font-sans text-gray-900 bg-white antialiased selection:bg-primary selection:text-gray-900">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <meta name="generator" content={Astro.generator} />
    <meta name="google-site-verification" content="YkmWhBua9touL0Y_UBguqRpt9ZOg1Z-plGU-XNrAoRs" />

    <!-- SEO & Social Cards -->
    <SEO
      title={title}
      description={description}
      canonicalUrl={canonicalUrl}
      ogImage={ogImage}
      ogType={ogType}
      noindex={noindex}
    />

    <!-- Google LocalBusiness JSON-LD Schema -->
    <SchemaLocalBusiness />
  </head>
  <body class="min-h-screen flex flex-col justify-between">
    <Header />
    <main class="flex-grow">
      <slot />
    </main>
    <Footer />
    <!-- Botão Flutuante de Conversão WhatsApp Premium -->
    <WhatsAppBtn />
  </body>
</html>

<style is:global>
  /* Fundamentos de Respiro: Preenchimento generoso em todas as seções principais */
  section {
    @apply py-24 lg:py-32;
  }
</style>
